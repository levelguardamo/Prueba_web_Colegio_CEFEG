---
import type { EtapaProceso } from '../../data/types';

interface Props {
  etapas: EtapaProceso[];
}
const { etapas } = Astro.props;

const idxActual = etapas.findIndex((e) => e.estado === 'actual');
const idxUltimaCompletada = (() => {
  let last = -1;
  etapas.forEach((e, i) => {
    if (e.estado === 'completada') last = i;
  });
  return last;
})();
// Progreso de la barra: hasta el paso actual (si hay uno) o hasta la última completada.
const idxProgreso = idxActual >= 0 ? idxActual : idxUltimaCompletada;
const porcentaje = etapas.length > 1 ? (Math.max(idxProgreso, 0) / (etapas.length - 1)) * 100 : 0;

function estilosDot(estado: EtapaProceso['estado']) {
  if (estado === 'completada') {
    return { bg: 'var(--terracota)', color: '#fff', border: 'var(--terracota)' };
  }
  if (estado === 'actual') {
    return { bg: 'var(--navy)', color: '#fff', border: '#fff' };
  }
  return { bg: 'transparent', color: '#9fb0cb', border: '#5c6c8c' };
}
---

<div class="stepper">
  <div class="stepper__track">
    <div class="stepper__track-fill" style={{ '--progreso': `${porcentaje}%` }} />
  </div>
  <div class="stepper__nodes">
    {
      etapas.map((etapa, i) => {
        const s = estilosDot(etapa.estado);
        return (
          <div class="stepper__node">
            <div class="stepper__dot" style={{ background: s.bg, color: s.color, borderColor: s.border }}>
              {etapa.estado === 'completada' ? '✓' : i + 1}
            </div>
            <span class="stepper__label" style={{ color: etapa.estado === 'pendiente' ? '#9fb0cb' : '#fff' }}>
              {etapa.label}
            </span>
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .stepper {
    position: relative;
    /* espacio reservado abajo para las etiquetas de 2 líneas, que ya no
       empujan la altura del contenedor (van position: absolute) */
    padding-bottom: 46px;
  }
  .stepper__track {
    position: absolute;
    top: 15px;
    left: 15px;
    right: 15px;
    height: 2px;
    background: var(--navy-soft);
  }
  .stepper__track-fill {
    width: var(--progreso);
    height: 100%;
    background: var(--terracota);
    transition: width 0.2s ease;
  }
  .stepper__nodes {
    position: relative;
    display: flex;
    justify-content: space-between;
  }
  /* Los nodos miden exactamente lo mismo que el círculo (30px) para que
     space-between los deje centrados en 0%, 25%, 50%, 75%, 100% del
     track — igual que asume el cálculo de --progreso de arriba. La
     etiqueta va aparte, position: absolute, para que su ancho variable
     (p. ej. "Capellanía y comité" en dos líneas) no altere esa
     distribución como pasaba antes. */
  .stepper__node {
    position: relative;
    width: 30px;
    flex-shrink: 0;
  }
  .stepper__dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    border: 2px solid;
    flex-shrink: 0;
  }
  .stepper__label {
    position: absolute;
    top: 38px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    font-size: 11.5px;
    text-align: center;
    font-weight: 600;
    line-height: 1.3;
  }

  /* En pantallas angostas, 5 columnas no caben sin solaparse: pasa a lista vertical. */
  @media (max-width: 560px) {
    .stepper {
      padding-bottom: 0;
    }
    .stepper__track {
      top: 0;
      bottom: 0;
      left: 15px;
      right: auto;
      width: 2px;
      height: auto;
    }
    .stepper__track-fill {
      width: 100%;
      height: var(--progreso);
    }
    .stepper__nodes {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
    }
    .stepper__node {
      position: static;
      width: auto;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .stepper__label {
      position: static;
      transform: none;
      width: auto;
      max-width: none;
      text-align: left;
    }
  }
</style>

---
// Ventana para agendar la cita de admisión.
// TODO(servidor): el POST del formulario debe crear la cita en Q10 y
// disparar la confirmación por WhatsApp (con el enlace mágico si es la
// primera cita del proceso). Los días habilitados por grado ya vienen de
// reglasAgendamiento.ts; lo único que falta para producción es validar
// contra la disponibilidad real (por si un cupo de un horario ya se llenó).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calendar from '../../components/admisiones/Calendar.astro';
import { REGLAS_POR_GRADO } from '../../data/reglasAgendamiento';

const gradoSeleccionado = 'secundaria';
const regla = REGLAS_POR_GRADO[gradoSeleccionado];

// El mes que se muestra siempre es el actual, para no quedar desactualizado.
const hoy = new Date();
const anio = hoy.getFullYear();
const mes = hoy.getMonth() + 1; // 1-12
const NOMBRES_MES = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre',
];
const nombreMes = NOMBRES_MES[mes - 1];

// Días cerrados siempre (lunes y jueves) — se repite aquí porque el
// cliente necesita esta misma regla para recalcular el calendario cuando
// cambia el grado, sin tener que volver a pedirle nada al servidor.
const DIAS_CERRADOS = [1, 4];
---

<BaseLayout title="Agendar cita de admisión">
  <main class="page">
    <div class="ventana">
      <div class="ventana__header">
        <div>
          <div class="ventana__marca">Colegio CEFEG</div>
          <div class="serif ventana__titulo">Agendar cita de admisión</div>
        </div>
      </div>

      <form class="ventana__body" method="post" action="/api/admisiones/citas" id="form-cita">
        <div class="ventana__col ventana__col--calendario">
          <Calendar
            anio={anio}
            mes={mes}
            nombreMes={nombreMes}
            diasHabilitados={regla.diasHabilitados}
          />
        </div>

        <div class="ventana__col ventana__col--datos">
          <label class="campo">
            <span>Grado al que aspira</span>
            <select name="grado" id="campo-grado">
              {Object.entries(REGLAS_POR_GRADO).map(([key, r]) => (
                <option value={key} selected={key === gradoSeleccionado}>
                  {r.grado}
                </option>
              ))}
            </select>
            <span class="campo__ayuda">El grado define automáticamente los días y horarios disponibles</span>
          </label>

          <div class="horarios">
            <label class="campo__label" id="horarios-label">Elige un día disponible en el calendario</label>
            <div class="horarios__lista" id="horarios-lista">
              <span class="horarios__vacio" id="horarios-vacio">Aún no hay una fecha seleccionada</span>
            </div>
          </div>

          <input type="hidden" name="fecha" id="campo-fecha" />

          <div class="datos-acudiente">
            <label class="campo">
              <span>Nombre del acudiente</span>
              <input type="text" name="acudiente" placeholder="Nombre completo" required />
            </label>
            <label class="campo">
              <span>Teléfono de contacto (WhatsApp)</span>
              <input type="tel" name="telefono" placeholder="Número de celular" required />
            </label>
          </div>

          <button class="btn btn--accent" type="submit" style="width: 100%" id="btn-confirmar" disabled>
            Confirmar cita
          </button>
          <div class="ventana__nota">Al confirmar, la cita queda registrada en Q10 y se notifica por WhatsApp</div>
        </div>
      </form>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ reglas: REGLAS_POR_GRADO, diasCerrados: DIAS_CERRADOS, nombreMes, anio, mes }}>
  // Hace funcional el formulario de agendamiento: al cambiar el grado se
  // recalculan qué días del calendario quedan habilitados, y al hacer
  // clic en un día disponible se cargan los horarios que le corresponden
  // (dependen del grado Y del día de la semana elegido). Todo corre en
  // el navegador porque el sitio es estático — no hay recarga de página.
  const DIAS_SEMANA = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];

  const selectGrado = document.getElementById('campo-grado');
  const grid = document.getElementById('calendario-grid');
  const horariosLista = document.getElementById('horarios-lista');
  const horariosLabel = document.getElementById('horarios-label');
  const campoFecha = document.getElementById('campo-fecha');
  const btnConfirmar = document.getElementById('btn-confirmar');

  let diaSeleccionado = null; // número de día del mes, o null

  function celdas() {
    return Array.from(grid.querySelectorAll('.calendario__celda[data-day]'));
  }

  function reglaActual() {
    return reglas[selectGrado.value];
  }

  // Repinta el calendario según el grado elegido: un día solo queda
  // "disponible" (clickeable) si no está en diasCerrados (lunes/jueves,
  // siempre cerrados) y si su día de la semana está en diasHabilitados
  // del grado actual.
  function repintarCalendario() {
    const regla = reglaActual();
    celdas().forEach((celda) => {
      const dow = Number(celda.dataset.dow);
      celda.classList.remove(
        'calendario__celda--cerrado',
        'calendario__celda--no-grado',
        'calendario__celda--disponible',
        'calendario__celda--seleccionado'
      );
      if (diasCerrados.includes(dow)) {
        celda.classList.add('calendario__celda--cerrado');
      } else if (!regla.diasHabilitados.includes(dow)) {
        celda.classList.add('calendario__celda--no-grado');
      } else if (Number(celda.dataset.day) === diaSeleccionado) {
        celda.classList.add('calendario__celda--seleccionado');
      } else {
        celda.classList.add('calendario__celda--disponible');
      }
    });
  }

  // Reconstruye los horarios disponibles para el día que se acaba de
  // seleccionar (dependen del grado y del día de la semana de esa fecha).
  function actualizarHorarios(dow) {
    const regla = reglaActual();
    const horarios = regla.horariosPorDia[dow] ?? [];

    horariosLista.innerHTML = '';
    horarios.forEach((h, i) => {
      const label = document.createElement('label');
      label.className = 'horario';
      label.innerHTML = `<input type="radio" name="horario" value="${h}" ${i === 0 ? 'checked' : ''}><span>${h}</span>`;
      horariosLista.appendChild(label);
    });

    const fechaObj = new Date(anio, mes - 1, diaSeleccionado);
    horariosLabel.textContent = `Horarios disponibles · ${DIAS_SEMANA[dow]} ${diaSeleccionado} de ${nombreMes.toLowerCase()}`;

    const iso = `${anio}-${String(mes).padStart(2, '0')}-${String(diaSeleccionado).padStart(2, '0')}`;
    campoFecha.value = iso;

    btnConfirmar.disabled = horarios.length === 0;
  }

  function limpiarSeleccion() {
    diaSeleccionado = null;
    campoFecha.value = '';
    horariosLabel.textContent = 'Elige un día disponible en el calendario';
    horariosLista.innerHTML = '<span class="horarios__vacio">Aún no hay una fecha seleccionada</span>';
    btnConfirmar.disabled = true;
  }

  grid.addEventListener('click', (evento) => {
    const celda = evento.target.closest('.calendario__celda--disponible, .calendario__celda--seleccionado');
    if (!celda) return;
    diaSeleccionado = Number(celda.dataset.day);
    repintarCalendario();
    actualizarHorarios(Number(celda.dataset.dow));
  });

  selectGrado.addEventListener('change', () => {
    limpiarSeleccion();
    repintarCalendario();
  });

  repintarCalendario();
</script>

<style>
  .page {
    display: flex;
    justify-content: center;
    padding: 0;
    background: #edece6;
    min-height: 100vh;
  }
  .ventana {
    width: 100%;
    background: #fff;
    border-radius: 0;
    box-shadow: none;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .ventana__header {
    background: var(--navy);
    padding: 22px 28px;
  }
  .ventana__marca {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #9fb0cb;
    font-weight: 700;
  }
  .ventana__titulo {
    font-size: 19px;
    font-weight: 700;
    color: #fff;
    margin-top: 2px;
  }
  .ventana__body {
    flex: 1;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 48px;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  .ventana__col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ventana__col--calendario {
    padding-right: 48px;
    border-right: 1px solid var(--line);
  }

  @media (max-width: 720px) {
    .ventana__body {
      grid-template-columns: 1fr;
      padding: 24px 22px 28px;
      gap: 24px;
    }
    .ventana__col--calendario {
      padding-right: 0;
      border-right: none;
      padding-bottom: 4px;
      border-bottom: 1px solid var(--line);
    }
  }
  .campo {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 700;
    color: #3b4457;
  }
  .campo select,
  .campo input {
    border: 1px solid #dcd9cf;
    border-radius: 4px;
    padding: 11px 14px;
    font-size: 14px;
    color: var(--text);
    font-weight: 400;
    font-family: var(--font-sans);
  }
  .campo__ayuda {
    font-size: 11.5px;
    color: var(--text-faint);
    font-weight: 400;
  }
  .campo__label {
    font-size: 12.5px;
    font-weight: 700;
    color: #3b4457;
    display: block;
    margin-bottom: 8px;
  }
  .horarios__lista {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    min-height: 38px;
    align-items: center;
  }
  .horarios__vacio {
    font-size: 12.5px;
    color: var(--text-faint);
    font-style: italic;
  }
  .horario {
    padding: 9px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #dcd9cf;
    color: var(--text);
    cursor: pointer;
  }
  .horario:has(input:checked) {
    background: var(--navy);
    color: #fff;
    border-color: var(--navy);
  }
  .horario input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .datos-acudiente {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
  }
  .ventana__nota {
    font-size: 11px;
    color: var(--text-faint);
    text-align: center;
  }
  #btn-confirmar:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

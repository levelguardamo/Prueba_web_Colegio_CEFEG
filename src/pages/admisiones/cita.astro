---
// Ventana para agendar la cita de admisión.
//
// Simulación para la demo: al confirmar, la cita se guarda en localStorage
// (nuevosAspirantes.ts) como un aspirante nuevo en la etapa "Cita inicial"
// — el mismo aspirante aparece en el panel de secretaría, en el mismo
// navegador, sin recargar nada. No hay servidor real detrás.
//
// TODO(servidor): el POST del formulario debe crear la cita en Q10 y
// disparar la confirmación por WhatsApp (con el enlace mágico si es la
// primera cita del proceso). Los días habilitados por grado ya vienen de
// reglasAgendamiento.ts; lo único que falta para producción es validar
// contra la disponibilidad real (por si un cupo de un horario ya se llenó).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calendar from '../../components/admisiones/Calendar.astro';
import {
  REGLAS_POR_GRADO,
  GRADOS_POR_NIVEL,
  NIVELES_SIN_GRADO_ESPECIFICO,
  NIVELES_SIN_VENTANA_DE_FECHAS,
} from '../../data/reglasAgendamiento';

const gradoSeleccionado = 'secundaria';
const regla = REGLAS_POR_GRADO[gradoSeleccionado];
const gradosEspecificos = GRADOS_POR_NIVEL[gradoSeleccionado];

// El mes que se muestra siempre es el actual, para no quedar desactualizado.
const hoy = new Date();
const anio = hoy.getFullYear();
const mes = hoy.getMonth() + 1; // 1-12
const NOMBRES_MES = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre',
];
const nombreMes = NOMBRES_MES[mes - 1];

// Días cerrados siempre (lunes y jueves) — se repite aquí porque el
// cliente necesita esta misma regla para recalcular el calendario cuando
// cambia el grado, sin tener que volver a pedirle nada al servidor.
const DIAS_CERRADOS = [1, 4];
---

<BaseLayout title="Agendar cita de admisión">
  <main class="page">
    <div class="ventana">
      <div class="ventana__header">
        <div>
          <div class="ventana__marca">Colegio CEFEG</div>
          <div class="serif ventana__titulo">Agendar cita de admisión</div>
        </div>
      </div>

      <form class="ventana__body" method="post" action="/api/admisiones/citas" id="form-cita">
        <div class="ventana__col ventana__col--calendario">
          <Calendar
            anio={anio}
            mes={mes}
            nombreMes={nombreMes}
            diasHabilitados={regla.diasHabilitados}
          />
        </div>

        <div class="ventana__col ventana__col--datos">
          <label class="campo">
            <span>Nivel educativo</span>
            <select name="nivel" id="campo-grado">
              {Object.entries(REGLAS_POR_GRADO).map(([key, r]) => (
                <option value={key} selected={key === gradoSeleccionado} data-grupal={String(r.grupal)}>
                  {r.grado}
                </option>
              ))}
            </select>
            <span class="campo__ayuda">El nivel define automáticamente los días y horarios disponibles</span>
          </label>

          <label class="campo" id="grado-especifico-wrap">
            <span>Grado al que aspira</span>
            <select name="gradoEspecifico" id="campo-grado-especifico">
              {gradosEspecificos.map((g) => <option value={g}>{g}</option>)}
            </select>
          </label>

          <div class="tipo-proceso">
            <span class="campo__label">¿El estudiante es nuevo o es un traspaso de otro colegio?</span>
            <div class="tipo-proceso__opciones">
              <label class="tipo-proceso__opcion">
                <input type="radio" name="tipoProceso" value="nuevo" checked />
                <span class="tipo-proceso__titulo">Estudiante nuevo</span>
                <span class="tipo-proceso__ayuda">Va a iniciar el grado por primera vez</span>
              </label>
              <label class="tipo-proceso__opcion">
                <input type="radio" name="tipoProceso" value="traslado" />
                <span class="tipo-proceso__titulo">Traspaso de colegio</span>
                <span class="tipo-proceso__ayuda">Ya inició el proceso escolar en ese grado y se traslada</span>
              </label>
            </div>
            <span class="campo__ayuda" id="tipo-proceso-ayuda"></span>
          </div>

          <div class="horarios">
            <label class="campo__label" id="horarios-label">Elige un día disponible en el calendario</label>
            <div class="horarios__lista" id="horarios-lista">
              <span class="horarios__vacio" id="horarios-vacio">Aún no hay una fecha seleccionada</span>
            </div>
          </div>

          <input type="hidden" name="fecha" id="campo-fecha" />
          <input type="hidden" id="campo-fecha-legible" />

          <div class="datos-acudiente">
            <label class="campo">
              <span>Nombre del estudiante</span>
              <input type="text" name="nombreNino" placeholder="Nombre completo del aspirante" required />
            </label>
            <label class="campo">
              <span>Nombre del acudiente</span>
              <input type="text" name="acudiente" placeholder="Nombre completo" required />
            </label>
            <label class="campo">
              <span>Teléfono de contacto (WhatsApp)</span>
              <input type="tel" name="telefono" placeholder="Número de celular" required />
            </label>
          </div>

          <button class="btn btn--accent" type="submit" style="width: 100%" id="btn-confirmar" disabled>
            Confirmar cita
          </button>
          <div class="ventana__nota">Al confirmar, la cita queda registrada en Q10 y se notifica por WhatsApp</div>
        </div>
      </form>

      <div class="confirmacion" id="confirmacion" hidden>
        <div class="serif confirmacion__titulo">Tu registro se realizó con éxito</div>
        <p class="confirmacion__aviso">Abajo se encuentra el código con el que podrás consultar el estado de admisión</p>
        <div class="confirmacion__icono" aria-hidden="true">↓</div>
        <p class="confirmacion__texto">
          Quedó registrada la cita de <strong id="confirmacion-nombre"></strong> para
          <strong id="confirmacion-grado"></strong>, el <strong id="confirmacion-fecha"></strong>.
        </p>
        <div class="confirmacion__radicado">
          <span>Número de radicado</span>
          <strong id="confirmacion-radicado"></strong>
        </div>
        <p class="confirmacion__nota">
          Guarda este número — lo vas a necesitar para consultar el proceso más adelante. En un momento
          secretaría revisa la solicitud y te contacta por WhatsApp al número que registraste.
        </p>
        <p class="confirmacion__nota confirmacion__nota--demo">
          (Esta es una prueba: la cita se guardó en este navegador y ya aparece en el panel de secretaría
          — no se envió ningún WhatsApp real todavía.)
        </p>
      </div>
    </div>
  </main>
</BaseLayout>

<script
  define:vars={{
    reglas: REGLAS_POR_GRADO,
    gradosPorNivel: GRADOS_POR_NIVEL,
    nivelesSinGradoEspecifico: NIVELES_SIN_GRADO_ESPECIFICO,
    nivelesSinVentana: NIVELES_SIN_VENTANA_DE_FECHAS,
    diasCerrados: DIAS_CERRADOS,
    nombresMes: NOMBRES_MES,
    anioInicial: anio,
    mesInicial: mes,
  }}
>
  // Hace funcional el formulario de agendamiento: al cambiar el nivel o el
  // tipo de proceso (nuevo/traslado) se recalcula qué días quedan
  // habilitados y en qué meses se puede navegar, y al hacer clic en un día
  // disponible se cargan los horarios que le corresponden. Todo corre en
  // el navegador porque el sitio es estático — no hay recarga de página, y
  // por eso el calendario de un mes cualquiera se arma aquí con JavaScript
  // (Calendar.astro solo pinta el mes actual al cargar la página).
  const DIAS_SEMANA = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
  const ETIQUETAS_LUNES = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];

  const selectGrado = document.getElementById('campo-grado');
  const selectGradoEspecifico = document.getElementById('campo-grado-especifico');
  const gradoEspecificoWrap = document.getElementById('grado-especifico-wrap');
  const radiosTipoProceso = document.querySelectorAll('input[name="tipoProceso"]');
  const tipoProcesoAyuda = document.getElementById('tipo-proceso-ayuda');
  const grid = document.getElementById('calendario-grid');
  const mesLabel = document.getElementById('calendario-mes-label');
  const btnMesAnterior = document.getElementById('calendario-prev');
  const btnMesSiguiente = document.getElementById('calendario-next');
  const horariosLista = document.getElementById('horarios-lista');
  const horariosLabel = document.getElementById('horarios-label');

  // Astro le agrega a cada elemento que genera en el build un atributo
  // data-astro-cid-XXXXX, y esa misma cadena queda pegada a sus selectores
  // CSS (así consigue que los estilos de un componente no choquen con los
  // de otro). Las celdas del calendario, en cambio, las armamos aquí a
  // mano con document.createElement — y esos elementos NO nacen con ese
  // atributo, así que sin copiarlo se verían sin el estilo de
  // Calendar.astro (mal alineadas, sin fondo ni cursor de "clickeable").
  // Se toma prestado de un elemento que sí viene del build y que nunca se
  // reemplaza (el encabezado del calendario), así funciona sin importar
  // cómo cambie el hash de un build a otro.
  const referenciaCid = document.querySelector('.calendario__hint');
  const atributoCid = referenciaCid
    ? Array.from(referenciaCid.attributes).find((attr) => attr.name.startsWith('data-astro-cid-'))
    : null;
  function marcarConCidAstro(el) {
    if (atributoCid) el.setAttribute(atributoCid.name, '');
  }
  const campoFecha = document.getElementById('campo-fecha');
  const campoFechaLegible = document.getElementById('campo-fecha-legible');
  const btnConfirmar = document.getElementById('btn-confirmar');

  let mesActual = mesInicial;
  let anioActual = anioInicial;
  let fechaSeleccionada = null; // Date, o null

  function nivelActual() {
    return selectGrado.value;
  }
  function tipoActual() {
    const marcado = Array.from(radiosTipoProceso).find((r) => r.checked);
    return marcado ? marcado.value : 'nuevo';
  }
  function reglaActual() {
    return reglas[nivelActual()];
  }

  // Ventana de fechas en la que se puede agendar, según el tipo de proceso:
  // - traslado: 15 de febrero al 21 de agosto del mismo año (todo el año
  //   escolar en curso), desde Transición hasta 11°.
  // - nuevo: 1 de agosto al 28/29 de febrero del año siguiente.
  // - Jardín no tiene ventana — se recibe todo el año (ver
  //   nivelesSinVentana / NIVELES_SIN_VENTANA_DE_FECHAS).
  // Si la ventana del año en curso ya se cerró, se usa la del siguiente
  // ciclo, para no dejar el formulario bloqueado el resto del año.
  function rangoElegible(nivel, tipo) {
    if (nivelesSinVentana.includes(nivel)) return null;
    const hoy = new Date();
    function ventana(base) {
      if (tipo === 'traslado') {
        return { desde: new Date(base, 1, 15), hasta: new Date(base, 7, 21, 23, 59, 59) };
      }
      return { desde: new Date(base, 7, 1), hasta: new Date(base + 1, 2, 0, 23, 59, 59) };
    }
    let rango = ventana(hoy.getFullYear());
    if (rango.hasta < hoy) rango = ventana(hoy.getFullYear() + 1);
    return rango;
  }

  function fechaDentroDeRango(fecha, rango) {
    if (!rango) return true;
    return fecha >= rango.desde && fecha <= rango.hasta;
  }

  // Primer y último mes navegables, según la ventana de fechas actual (y
  // sin permitir ir a meses ya pasados).
  function limitesDeMeses() {
    const rango = rangoElegible(nivelActual(), tipoActual());
    const hoy = new Date();
    if (!rango) {
      const max = new Date(hoy.getFullYear(), hoy.getMonth() + 12, 1);
      return {
        min: { anio: hoy.getFullYear(), mes: hoy.getMonth() + 1 },
        max: { anio: max.getFullYear(), mes: max.getMonth() + 1 },
      };
    }
    const desdeEfectivo = rango.desde > hoy ? rango.desde : hoy;
    return {
      min: { anio: desdeEfectivo.getFullYear(), mes: desdeEfectivo.getMonth() + 1 },
      max: { anio: rango.hasta.getFullYear(), mes: rango.hasta.getMonth() + 1 },
    };
  }

  function clave(anio, mesNum) {
    return anio * 12 + mesNum;
  }

  function construirCeldas(anioNum, mesNum) {
    const primerDia = new Date(anioNum, mesNum - 1, 1);
    const ultimoDia = new Date(anioNum, mesNum, 0).getDate();
    const offset = (primerDia.getDay() + 6) % 7; // 0=lunes
    const celdas = [];
    for (let i = 0; i < offset; i++) celdas.push(null);
    for (let d = 1; d <= ultimoDia; d++) {
      celdas.push({ num: d, fecha: new Date(anioNum, mesNum - 1, d) });
    }
    return celdas;
  }

  // Dibuja el mes que esté en (anioActual, mesActual): la cuadrícula, el
  // nombre del mes y si los botones de mes anterior/siguiente quedan
  // habilitados. Se llama cada vez que cambia el mes, el nivel o el tipo
  // de proceso, porque los tres pueden cambiar qué días están disponibles.
  function pintarCalendario() {
    const regla = reglaActual();
    const rango = rangoElegible(nivelActual(), tipoActual());

    mesLabel.textContent = `${nombresMes[mesActual - 1]} ${anioActual}`;

    grid.innerHTML = '';
    ETIQUETAS_LUNES.forEach((et) => {
      const span = document.createElement('span');
      span.className = 'calendario__etiqueta';
      span.textContent = et;
      marcarConCidAstro(span);
      grid.appendChild(span);
    });

    construirCeldas(anioActual, mesActual).forEach((c) => {
      const div = document.createElement('div');
      marcarConCidAstro(div);
      if (!c) {
        div.className = 'calendario__celda calendario__celda--blank';
        grid.appendChild(div);
        return;
      }
      const dow = c.fecha.getDay();
      div.dataset.day = String(c.num);
      div.dataset.dow = String(dow);
      let tipo;
      if (diasCerrados.includes(dow)) {
        tipo = 'cerrado';
      } else if (!regla.diasHabilitados.includes(dow)) {
        tipo = 'no-grado';
      } else if (!fechaDentroDeRango(c.fecha, rango)) {
        tipo = 'no-grado';
      } else if (fechaSeleccionada && c.fecha.getTime() === fechaSeleccionada.getTime()) {
        tipo = 'seleccionado';
      } else {
        tipo = 'disponible';
      }
      div.className = `calendario__celda calendario__celda--${tipo}`;
      div.textContent = String(c.num);
      grid.appendChild(div);
    });

    const { min, max } = limitesDeMeses();
    btnMesAnterior.disabled = clave(anioActual, mesActual) <= clave(min.anio, min.mes);
    btnMesSiguiente.disabled = clave(anioActual, mesActual) >= clave(max.anio, max.mes);

    tipoProcesoAyuda.textContent = rango
      ? `Con esta opción se puede agendar entre el ${rango.desde.getDate()} de ${nombresMes[rango.desde.getMonth()].toLowerCase()} y el ${rango.hasta.getDate()} de ${nombresMes[rango.hasta.getMonth()].toLowerCase()} de ${rango.hasta.getFullYear()}`
      : 'Este nivel se recibe en cualquier momento del año';
  }

  function cambiarMes(delta) {
    let nuevoMes = mesActual + delta;
    let nuevoAnio = anioActual;
    if (nuevoMes < 1) {
      nuevoMes = 12;
      nuevoAnio -= 1;
    } else if (nuevoMes > 12) {
      nuevoMes = 1;
      nuevoAnio += 1;
    }
    const { min, max } = limitesDeMeses();
    const k = clave(nuevoAnio, nuevoMes);
    if (k < clave(min.anio, min.mes) || k > clave(max.anio, max.mes)) return;
    mesActual = nuevoMes;
    anioActual = nuevoAnio;
    pintarCalendario();
  }

  // Reconstruye los horarios disponibles para el día que se acaba de
  // seleccionar (dependen del nivel y del día de la semana de esa fecha).
  function actualizarHorarios() {
    const regla = reglaActual();
    const dow = fechaSeleccionada.getDay();
    const horarios = regla.horariosPorDia[dow] ?? [];

    horariosLista.innerHTML = '';
    horarios.forEach((h, i) => {
      const label = document.createElement('label');
      label.className = 'horario';
      label.innerHTML = `<input type="radio" name="horario" value="${h}" ${i === 0 ? 'checked' : ''}><span>${h}</span>`;
      horariosLista.appendChild(label);
    });

    const diaSemanaCap = DIAS_SEMANA[dow].charAt(0).toUpperCase() + DIAS_SEMANA[dow].slice(1);
    const nombreMesSel = nombresMes[fechaSeleccionada.getMonth()].toLowerCase();
    horariosLabel.textContent = `Horarios disponibles · ${DIAS_SEMANA[dow]} ${fechaSeleccionada.getDate()} de ${nombreMesSel}`;

    const iso = `${fechaSeleccionada.getFullYear()}-${String(fechaSeleccionada.getMonth() + 1).padStart(2, '0')}-${String(fechaSeleccionada.getDate()).padStart(2, '0')}`;
    campoFecha.value = iso;
    // Fecha en texto plano (sin la hora todavía — se completa con el
    // horario elegido en el otro script, al confirmar) para que el
    // aspirante creado en localStorage tenga una fecha legible.
    campoFechaLegible.value = `${diaSemanaCap} ${fechaSeleccionada.getDate()} de ${nombreMesSel}`;

    btnConfirmar.disabled = horarios.length === 0;
  }

  // Repuebla el selector de "grado al que aspira" (el específico, ej. "7°")
  // según el nivel educativo elegido en el selector de arriba — cada nivel
  // agrupa varios grados que comparten agenda.
  function repintarGradoEspecifico() {
    const grados = gradosPorNivel[nivelActual()] ?? [];
    selectGradoEspecifico.innerHTML = grados.map((g) => `<option value="${g}">${g}</option>`).join('');
  }

  // Jardín y Transición son un único grado cada uno, así que no tiene
  // sentido mostrar el selector de grado específico para ellos (aunque
  // sigue poblado por detrás, con esa única opción, para que el envío del
  // formulario no tenga que tratarlos distinto).
  function actualizarVisibilidadGradoEspecifico() {
    gradoEspecificoWrap.hidden = nivelesSinGradoEspecifico.includes(nivelActual());
  }

  function limpiarSeleccion() {
    fechaSeleccionada = null;
    campoFecha.value = '';
    horariosLabel.textContent = 'Elige un día disponible en el calendario';
    horariosLista.innerHTML = '<span class="horarios__vacio">Aún no hay una fecha seleccionada</span>';
    btnConfirmar.disabled = true;
  }

  // Al cambiar el nivel o el tipo de proceso cambia también qué ventana de
  // fechas aplica, así que el calendario salta al primer mes válido de esa
  // ventana en vez de quedarse mostrando un mes que ya no aplica.
  function alCambiarFiltro() {
    limpiarSeleccion();
    actualizarVisibilidadGradoEspecifico();
    repintarGradoEspecifico();
    const { min } = limitesDeMeses();
    mesActual = min.mes;
    anioActual = min.anio;
    pintarCalendario();
  }

  grid.addEventListener('click', (evento) => {
    const celda = evento.target.closest('.calendario__celda--disponible, .calendario__celda--seleccionado');
    if (!celda) return;
    fechaSeleccionada = new Date(anioActual, mesActual - 1, Number(celda.dataset.day));
    pintarCalendario();
    actualizarHorarios();
  });

  btnMesAnterior.addEventListener('click', () => cambiarMes(-1));
  btnMesSiguiente.addEventListener('click', () => cambiarMes(1));

  selectGrado.addEventListener('change', alCambiarFiltro);
  radiosTipoProceso.forEach((r) => r.addEventListener('change', alCambiarFiltro));

  actualizarVisibilidadGradoEspecifico();
  pintarCalendario();
</script>

<script>
  // --- Confirmar cita: crea el aspirante en localStorage (simulación) ---
  //
  // Va en un <script> aparte (sin define:vars) porque necesita un import
  // normal de nuevosAspirantes.ts, y los scripts con define:vars se
  // insertan como texto plano, no como módulo — no soportan import.
  //
  // El formulario ya no manda un POST de verdad (no hay backend real
  // detrás todavía, ver el TODO(servidor) arriba): en vez de eso, arma el
  // aspirante nuevo con crearAspiranteDesdeCita y lo guarda en el
  // navegador, para que aparezca en el panel de secretaría. Luego muestra
  // la pantalla de confirmación en vez de recargar la página.
  import { crearAspiranteDesdeCita } from '../../scripts/nuevosAspirantes';

  const form = document.getElementById('form-cita') as HTMLFormElement;
  const confirmacion = document.getElementById('confirmacion') as HTMLElement;

  form.addEventListener('submit', (evento) => {
    evento.preventDefault();

    const datosForm = new FormData(form);
    const horario = String(datosForm.get('horario') ?? '');
    const fechaBase = String(datosForm.get('fecha') ?? '');
    if (!fechaBase) return; // sin fecha elegida, no hay nada que confirmar

    const opcionNivel = (document.getElementById('campo-grado') as HTMLSelectElement).selectedOptions[0];
    const gradoLabel = (document.getElementById('campo-grado-especifico') as HTMLSelectElement).value;
    const grupal = opcionNivel?.dataset.grupal === 'true';
    const tipoProceso = String(datosForm.get('tipoProceso') ?? 'nuevo') as 'nuevo' | 'traslado';

    const fechaLegibleBase = (document.getElementById('campo-fecha-legible') as HTMLInputElement).value;
    const fechaLegible = horario ? `${fechaLegibleBase} · ${horario}` : fechaLegibleBase;

    const aspirante = crearAspiranteDesdeCita({
      nombreNino: String(datosForm.get('nombreNino') ?? ''),
      acudiente: String(datosForm.get('acudiente') ?? ''),
      telefono: String(datosForm.get('telefono') ?? ''),
      gradoLabel,
      fechaLegible,
      fechaISO: fechaBase,
      grupal,
      tipoProceso,
    });

    (document.getElementById('confirmacion-nombre') as HTMLElement).textContent = aspirante.nombre;
    (document.getElementById('confirmacion-grado') as HTMLElement).textContent = aspirante.grado;
    (document.getElementById('confirmacion-fecha') as HTMLElement).textContent = fechaLegible;
    (document.getElementById('confirmacion-radicado') as HTMLElement).textContent = aspirante.radicado;

    form.hidden = true;
    confirmacion.hidden = false;
  });
</script>

<style>
  .page {
    display: flex;
    justify-content: center;
    padding: 0;
    background: #edece6;
    min-height: 100vh;
  }
  .ventana {
    width: 100%;
    background: #fff;
    border-radius: 0;
    box-shadow: none;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .ventana__header {
    background: var(--navy);
    padding: 22px 28px;
  }
  .ventana__marca {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #9fb0cb;
    font-weight: 700;
  }
  .ventana__titulo {

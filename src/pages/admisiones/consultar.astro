---
// Respaldo por si el acudiente pierde el enlace mágico de WhatsApp.
// TODO(servidor): este formulario debe hacer POST a un endpoint (p. ej.
// /api/admisiones/consultar) que valide radicado + últimos 4 dígitos
// contra la base real y redirija a /admisiones/seguimiento/<token>.
// Por ahora es solo la interfaz.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Consultar mi proceso">
  <main class="page">
    <div class="card">
      <div class="eyebrow">Colegio CEFEG</div>
      <h1 class="serif titulo">Consultar mi proceso de admisión</h1>
      <p class="subtitulo">
        Escribe el número de radicado y los últimos 4 dígitos del celular con el que te registraste.
      </p>

      <form class="form" method="post" action="/api/admisiones/consultar">
        <label class="campo">
          <span>Número de radicado</span>
          <input type="text" name="radicado" placeholder="#ADM-2026-0184" required />
        </label>
        <label class="campo">
          <span>Últimos 4 dígitos del celular</span>
          <input type="text" name="ultimos4" inputmode="numeric" maxlength="4" placeholder="1234" required />
        </label>
        <button class="btn btn--accent" type="submit">Consultar</button>
      </form>

      <p class="ayuda">
        ¿Ya tienes el enlace que te enviamos por WhatsApp? Úsalo directamente, es más rápido.
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: 480px;
    margin: 0 auto;
    padding: 60px 24px;
  }
  .eyebrow {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--terracota);
    font-weight: 700;
    margin-bottom: 8px;
  }
  .titulo {
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 700;
    color: var(--navy);
  }
  .subtitulo {
    margin: 0 0 24px;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .campo {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 700;
    color: #3b4457;
  }
  .campo input {
    border: 1px solid #dcd9cf;
    border-radius: 4px;
    padding: 11px 14px;
    font-size: 14px;
    color: var(--text);
    font-weight: 400;
    font-family: var(--font-sans);
  }
  .ayuda {
    margin: 16px 0 0;
    font-size: 12px;
    color: var(--text-faint);
    text-align: center;
  }
</style>

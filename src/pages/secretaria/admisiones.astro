---
// Panel interno de secretaría.
// TODO(servidor): esta ruta debe quedar detrás de autenticación real
// (usuario/contraseña), a diferencia del acceso ligero de los padres.
// Los checkboxes y el botón de envío deben pegar a endpoints propios que
// actualicen el estado en la base / Q10 y disparen el envío de WhatsApp.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ApplicantsTable from '../../components/admisiones/ApplicantsTable.astro';
import PanelAspirante from '../../components/admisiones/PanelAspirante.astro';
import { aspirantesTabla } from '../../data/mockSecretaria';
---

<BaseLayout title="Panel de secretaría">
  <main class="page">
    <div class="tabs" role="tablist">
      <button type="button" class="tabs__boton tabs__boton--activo" role="tab" aria-selected="true" data-tab="aspirantes">
        Aspirantes
      </button>
      <button type="button" class="tabs__boton" role="tab" aria-selected="false" data-tab="citas">
        Citas agendadas
      </button>
    </div>

    <div class="grid" id="vista-aspirantes" data-vista="aspirantes">
      <ApplicantsTable filas={aspirantesTabla} />

      <div class="grid__right">
        {
          aspirantesTabla.map((f, i) => (
            <PanelAspirante aspirante={f} index={i} activo={i === 0} urlPortalPadre={`/admisiones/seguimiento/${f.token}`} />
          ))
        }
      </div>
    </div>

    <div class="citas card" id="vista-citas" data-vista="citas" hidden>
      <div class="citas__header">
        <div>
          <div class="serif citas__titulo">Citas agendadas</div>
          <p class="citas__subtitulo">
            Agrupadas por fecha y horario — una reunión grupal aparece como un solo bloque con todas las
            familias que la comparten.
          </p>
        </div>
        <input type="search" class="citas__buscador" id="citas-buscador" placeholder="Buscar por nombre, acudiente o grado…" />
      </div>
      <div class="citas__lista" id="citas-lista"></div>
    </div>
  </main>
</BaseLayout>

<script>
  import type { Aspirante, PasoManual, ResultadoAdmision } from '../../data/types';
  import { ETAPAS_ORDEN } from '../../data/types';
  import type { DatosEditables } from '../../scripts/estadoAspirantes';
  import {
    actualizarPaso,
    actualizarResultado,
    actualizarDatos,
    marcarEliminado,
    actualizarArchivo,
    leerCambios,
  } from '../../scripts/estadoAspirantes';
  import { leerNuevosAspirantes } from '../../scripts/nuevosAspirantes';
  import { aspirantesTabla } from '../../data/mockSecretaria';

  // --- Aspirantes agendados desde /admisiones/cita (nacidos en el navegador) ---
  //
  // Estos NO vienen del build (mockData.ts), así que no tienen su fila ni
  // su ficha generadas por ApplicantsTable.astro / PanelAspirante.astro.
  // Se agregan aquí, apenas carga la página, leyendo lo que haya en
  // localStorage — por eso el resto del script usa delegación de eventos
  // (escucha en el documento, no en cada fila/botón) en vez de recorrer
  // los elementos uno por uno: así lo agregado aquí queda conectado igual
  // que lo que vino del build, sin tener que cablear nada aparte.
  //
  // Limitación de esta demo: estos aspirantes no tienen página propia en
  // /admisiones/seguimiento/<token> (esa ruta solo existe, prerenderizada,
  // para los tokens que ya estaban en mockData.ts al hacer build) — por
  // eso su ficha no trae el botón "Ver portal del padre".

  // Astro "escopa" los estilos de ApplicantsTable.astro y PanelAspirante.astro
  // agregando un atributo data-astro-cid-XXXXX a cada elemento que generan
  // en el build, y esa misma cadena se le pega a sus selectores CSS. Los
  // elementos que armamos aquí a mano con JS no nacen con ese atributo, así
  // que sin esto se verían sin ningún estilo de esos dos componentes (solo
  // con lo que trae global.css). Se copia del primer elemento real que ya
  // existe en la página, así funciona sin importar cómo cambie el hash de
  // un build a otro.
  function copiarCidAstro(referenciaSelector: string, contenedor: HTMLElement) {
    const referencia = document.querySelector(referenciaSelector);
    if (!referencia) return;
    const atributoCid = Array.from(referencia.attributes).find((attr) => attr.name.startsWith('data-astro-cid-'));
    if (!atributoCid) return;
    contenedor.setAttribute(atributoCid.name, '');
    contenedor.querySelectorAll('*').forEach((el) => el.setAttribute(atributoCid.name, ''));
  }

  function escapeHtml(s: string) {
    const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    return s.replace(/[&<>"']/g, (c) => map[c]);
  }
  function chipClase(valor: string) {
    if (valor === 'Pagado' || valor === 'Aprobado') return 'chip chip--success';
    if (valor === 'Pendiente') return 'chip chip--pending';
    if (valor === 'Rechazado') return 'chip chip--rechazado';
    return 'chip chip--neutro';
  }
  function etapaLabelDe(a: Aspirante) {
    return ETAPAS_ORDEN.find((e) => e.id === a.etapaActual)?.label ?? a.etapaActual;
  }
  function formularioLabelDe(a: Aspirante) {
    const paso = a.pasos.find((p) => p.id === 'formulario_pagado');
    return paso?.completado ? 'Pagado' : 'Pendiente';
  }
  function comiteLabelDe(a: Aspirante) {
    if (a.resultado === 'admitido') return 'Aprobado';
    if (a.resultado === 'rechazado') return 'Rechazado';
    const paso = a.pasos.find((p) => p.id === 'comite_aprobo');
    return paso?.completado ? 'Aprobado' : 'Pendiente';
  }

  function crearFila(a: Aspirante, indice: number): HTMLElement {
    const fila = document.createElement('div');
    fila.className = 'tabla__fila tabla__fila--seleccionable';
    fila.dataset.index = String(indice);
    fila.dataset.token = a.token;
    fila.tabIndex = 0;
    fila.setAttribute('role', 'button');
    fila.innerHTML = `
      <span class="tabla__nombre" data-label="Aspirante" data-campo="nombre">${escapeHtml(a.nombre)}</span>
      <span class="tabla__texto" data-label="Grado" data-campo="grado">${escapeHtml(a.grado)}</span>
      <span class="tabla__etapa" data-label="Etapa actual">${escapeHtml(etapaLabelDe(a))}</span>
      <span class="${chipClase(formularioLabelDe(a))}" data-label="Formulario" data-campo="formulario">${formularioLabelDe(a)}</span>
      <span class="${chipClase(comiteLabelDe(a))}" data-label="Comité" data-campo="comite">${comiteLabelDe(a)}</span>
      <span class="tabla__acciones">
        <button class="tabla__accion-btn" type="button" data-token="${a.token}" data-accion="editar" title="Editar datos">✎</button>
        <button class="tabla__accion-btn tabla__accion-btn--peligro" type="button" data-token="${a.token}" data-accion="eliminar" title="Eliminar aspirante">🗑</button>
      </span>
    `;
    copiarCidAstro('.tabla__fila[data-index]', fila);
    return fila;
  }

  function crearPanel(a: Aspirante, indice: number): HTMLElement {
    const indiceAbierto = a.pasos.findIndex((p) => !p.completado);
    const pasosPrevios = a.pasos.filter((p) => p.id !== 'comite_aprobo');
    const todosPreviosCompletos = pasosPrevios.every((p) => p.completado);

    const pasosHtml = a.pasos
      .map((paso, i) => {
        let acciones = '';
        if (paso.tipo === 'documento') {
          // "formulario_pagado" solo llega aquí como 'documento' para un
          // aspirante nacido en esta demo (ver la nota en
          // nuevosAspirantes.ts) — necesita su propio texto, porque en
          // producción ese paso lo confirma Q10 solo.
          const etiqueta =
            paso.id === 'formulario_pagado' ? 'Marcar como pagado (simula la confirmación de Q10)' : 'Marcar como recibido en físico';
          acciones = `
            <label class="check">
              <input type="checkbox" ${paso.completado ? 'checked' : ''} data-token="${a.token}" data-paso-id="${paso.id}">
              ${etiqueta}
            </label>
            ${
              paso.id === 'formulario_pagado'
                ? ''
                : `<button class="btn btn--outline" type="button" data-accion="subir-archivo" data-token="${a.token}" data-paso-id="${paso.id}">Subir archivo</button>
                   <input type="file" class="input-archivo-oculto" hidden data-input-archivo="${paso.id}" data-token="${a.token}" data-paso-id="${paso.id}">
                   <span class="archivo-nombre" data-campo="archivo-nombre"></span>`
            }
          `;
        } else if (paso.tipo === 'automatico') {
          acciones = `
            <span class="chip ${paso.completado ? 'chip--success' : 'chip--pending'}" data-campo="chip-pago">${
              paso.completado ? 'Confirmado automáticamente por Q10' : 'Q10 todavía no confirma el pago'
            }</span>
            <button class="btn btn--outline btn--accion" type="button" data-accion="simular-pago" data-token="${a.token}" data-paso-id="${paso.id}" data-completado="${paso.completado}">
              ${paso.completado ? 'Simular: marcar como no pagado' : 'Simular: marcar como pagado'}
            </button>
            <p class="paso__nota">
              Botón temporal mientras no existe la conexión real con Q10 — simula que el webhook de pago
              llegó (o se revirtió), solo para poder probar el flujo completo.
            </p>
          `;
        } else if (paso.tipo === 'aprobacion') {
          acciones = `
            <div class="comite-acciones">
              <button
                class="btn btn--outline btn--accion btn--accion-aprobar ${a.resultado === 'admitido' ? 'btn--accion-activo' : ''}"
                type="button" data-token="${a.token}" data-accion="aprobar" ${!todosPreviosCompletos ? 'disabled' : ''}
              >Admitir estudiante</button>
              <button
                class="btn btn--outline btn--accion btn--accion-rechazar ${a.resultado === 'rechazado' ? 'btn--accion-activo' : ''}"
                type="button" data-token="${a.token}" data-accion="rechazar" ${!todosPreviosCompletos ? 'disabled' : ''}
              >Rechazar cupo</button>
            </div>
            <p class="paso__nota" data-campo="nota-bloqueo" ${todosPreviosCompletos ? 'hidden' : ''}>
              Falta completar los pasos anteriores (formulario en físico, pago y papelería) antes de poder
              admitir o rechazar el cupo.
            </p>
            <p class="paso__nota">
              Al admitir se envía sola la bienvenida — el popup en el portal del padre y el mensaje de
              WhatsApp, sin necesidad de hacerlo a mano desde aquí. (En esta prueba, el "envío" se simula
              guardando el estado en este navegador.)
            </p>
          `;
        }
        return `
          <details class="paso" data-paso-id="${paso.id}" ${i === indiceAbierto ? 'open' : ''}>
            <summary class="paso__resumen">
              <span class="paso__dot ${paso.completado ? 'paso__dot--completo' : ''}" data-campo="dot" data-numero="${i + 1}">${
                paso.completado ? '✓' : i + 1
              }</span>
              <span class="paso__texto">
                <span class="paso__label">${escapeHtml(paso.label)}</span>
                <span class="paso__estado" data-campo="estado">${
                  paso.tipo === 'automatico'
                    ? paso.completado
                      ? 'Confirmado por Q10'
                      : 'Aún no confirma Q10'
                    : paso.completado
                      ? 'Completado'
                      : 'Pendiente'
                }</span>
              </span>
            </summary>
            <div class="paso__acciones">${acciones}</div>
          </details>
        `;
      })
      .join('');

    const panel = document.createElement('div');
    panel.className = 'panel card';
    panel.dataset.panelIndex = String(indice);
    panel.dataset.token = a.token;
    panel.dataset.pasosBase = JSON.stringify(a.pasos);
    panel.hidden = true;
    panel.innerHTML = `
      <div class="panel__header">
        <div class="panel__header-top">
          <div>
            <div class="eyebrow">Ficha del aspirante</div>
            <div class="serif panel__nombre" data-campo="nombre">${escapeHtml(a.nombre)}</div>
            <div class="panel__grado" data-campo="grado">${escapeHtml(a.grado)}</div>
          </div>
          <div class="panel__header-acciones">
            <button class="btn btn--outline btn--accion" type="button" data-token="${a.token}" data-accion="editar">Editar datos</button>
            <button class="btn btn--outline btn--accion btn--peligro" type="button" data-token="${a.token}" data-accion="eliminar">Eliminar aspirante</button>
          </div>
        </div>
        <div class="panel__resultado" data-campo="resultado-badge" ${a.resultado === 'pendiente' ? 'hidden' : ''}>
          ${a.resultado === 'admitido' ? 'Cupo admitido ✓' : a.resultado === 'rechazado' ? 'Cupo rechazado' : ''}
        </div>
        <div class="panel__edicion" data-campo="form-edicion" hidden>
          <label class="campo-edicion">
            <span>Nombre del aspirante</span>
            <input type="text" data-campo-edicion="nombre" value="${escapeHtml(a.nombre)}">
          </label>
          <label class="campo-edicion">
            <span>Grado</span>
            <input type="text" data-campo-edicion="grado" value="${escapeHtml(a.grado)}">
          </label>
          <label class="campo-edicion">
            <span>Nombre del acudiente</span>
            <input type="text" data-campo-edicion="acudienteNombre" value="${escapeHtml(a.acudiente.nombre)}">
          </label>
          <label class="campo-edicion">
            <span>Teléfono del acudiente</span>
            <input type="text" data-campo-edicion="acudienteTelefono" value="${escapeHtml(a.acudiente.telefono)}">
          </label>
          <div class="panel__edicion-botones">
            <button class="btn btn--accent" type="button" data-token="${a.token}" data-accion="guardar-edicion">Guardar cambios</button>
            <button class="btn btn--outline" type="button" data-accion="cancelar-edicion">Cancelar</button>
          </div>
        </div>
      </div>
      <div class="progreso">${pasosHtml}</div>
      <details class="info-padres">
        <summary class="info-padres__resumen">
          <span>Información de los padres</span>
          <span class="info-padres__flecha">▾</span>
        </summary>
        <div class="info-padres__cuerpo">
          <div class="info-padres__fila"><span class="info-padres__label">Acudiente</span><span data-campo="acudiente-nombre">${escapeHtml(a.acudiente.nombre)}</span></div>
          <div class="info-padres__fila"><span class="info-padres__label">Teléfono</span><span data-campo="acudiente-telefono">${escapeHtml(a.acudiente.telefono)}</span></div>
          <div class="info-padres__fila"><span class="info-padres__label">Radicado</span><span>${escapeHtml(a.acudiente.radicado)}</span></div>
          <p class="paso__nota">Agendado desde el formulario público — en esta prueba no tiene un portal de
          seguimiento propio (eso necesita el backend real).</p>
        </div>
      </details>
    `;
    copiarCidAstro('.panel[data-panel-index]', panel);
    return panel;
  }

  const tabla = document.querySelector('.tabla');
  const gridRight = document.querySelector('.grid__right');
  let siguienteIndice = document.querySelectorAll('.tabla__fila[data-index]').length;

  leerNuevosAspirantes().forEach((a) => {
    tabla?.appendChild(crearFila(a, siguienteIndice));
    gridRight?.appendChild(crearPanel(a, siguienteIndice));
    siguienteIndice++;
  });

  // Coordina la tabla de aspirantes (izquierda) con su ficha de detalle
  // (derecha): al hacer clic o navegar con teclado a una fila, se muestra
  // el panel que le corresponde y se oculta el resto. Con delegación de
  // eventos en vez de un listener por fila, para que también funcione con
  // las filas agregadas arriba.
  function seleccionar(indice: string) {
    document.querySelectorAll<HTMLElement>('.tabla__fila[data-index]').forEach((fila) => {
      fila.classList.toggle('tabla__fila--activa', fila.dataset.index === indice);
    });
    document.querySelectorAll<HTMLElement>('.panel[data-panel-index]').forEach((panel) => {
      panel.hidden = panel.dataset.panelIndex !== indice;
    });
  }

  tabla?.addEventListener('click', (evento) => {
    const fila = (evento.target as HTMLElement).closest<HTMLElement>('.tabla__fila[data-index]');
    if (fila?.dataset.index !== undefined) seleccionar(fila.dataset.index);
  });
  tabla?.addEventListener('keydown', (evento) => {
    const e = evento as KeyboardEvent;
    const fila = (e.target as HTMLElement).closest<HTMLElement>('.tabla__fila[data-index]');
    if (!fila || fila.dataset.index === undefined) return;
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      seleccionar(fila.dataset.index);
    }
  });

  // --- Interconexión con el portal del padre (simulada con localStorage) ---
  //
  // Esto es una MAQUETA de lo que hará el backend real: cada cambio que
  // hace secretaría aquí se guarda en el navegador, y el portal del padre
  // (/admisiones/seguimiento/<token>) lee esos mismos cambios al abrirse.
  // Solo funciona probando ambas páginas en el mismo navegador — para que
  // funcione entre dispositivos distintos hace falta el backend real
  // (ver TODO(servidor) en estadoAspirantes.ts).

  function aplicarPasoADom(token: string, pasoId: PasoManual['id'], completado: boolean) {
    const detalle = document.querySelector<HTMLDetailsElement>(
      `.panel[data-token="${token}"] details[data-paso-id="${pasoId}"]`
    );
    if (detalle) {
      const checkbox = detalle.querySelector<HTMLInputElement>(`input[data-paso-id="${pasoId}"]`);
      if (checkbox) checkbox.checked = completado;
      const dot = detalle.querySelector<HTMLElement>('[data-campo="dot"]');
      if (dot) {
        dot.classList.toggle('paso__dot--completo', completado);
        dot.textContent = completado ? '✓' : (dot.dataset.numero ?? '');
      }
      const estado = detalle.querySelector<HTMLElement>('[data-campo="estado"]');
      if (estado) estado.textContent = completado ? 'Completado' : 'Pendiente';

      // Paso "automatico" (Q10): además del estado genérico de arriba, el
      // chip propio del paso y el botón de simulación deben quedar acordes.
      const chipPago = detalle.querySelector<HTMLElement>('[data-campo="chip-pago"]');
      if (chipPago) {
        chipPago.textContent = completado ? 'Confirmado automáticamente por Q10' : 'Q10 todavía no confirma el pago';
        chipPago.className = `chip ${completado ? 'chip--success' : 'chip--pending'}`;
      }
      const botonSimular = detalle.querySelector<HTMLButtonElement>('button[data-accion="simular-pago"]');
      if (botonSimular) {
        botonSimular.dataset.completado = String(completado);
        botonSimular.textContent = completado ? 'Simular: marcar como no pagado' : 'Simular: marcar como pagado';
      }
    }
    if (pasoId === 'formulario_pagado') {
      const chip = document.querySelector<HTMLElement>(`.tabla__fila[data-token="${token}"] [data-campo="formulario"]`);
      if (chip) {
        chip.textContent = completado ? 'Pagado' : 'Pendiente';
        chip.className = `chip ${completado ? 'chip--success' : 'chip--pending'}`;
      }
    }
  }

  // Muestra el nombre del archivo "subido" (simulado) junto al botón de
  // ese paso — ver la nota de CambiosAspirante.archivos.
  function aplicarArchivoADom(token: string, pasoId: PasoManual['id'], nombreArchivo: string) {
    const detalle = document.querySelector<HTMLElement>(
      `.panel[data-token="${token}"] details[data-paso-id="${pasoId}"]`
    );
    const span = detalle?.querySelector<HTMLElement>('[data-campo="archivo-nombre"]');
    if (span) span.textContent = nombreArchivo;
  }

  function aplicarResultadoADom(token: string, resultado: ResultadoAdmision) {
    const chipComite = document.querySelector<HTMLElement>(`.tabla__fila[data-token="${token}"] [data-campo="comite"]`);
    if (chipComite) {
      const texto = resultado === 'admitido' ? 'Aprobado' : resultado === 'rechazado' ? 'Rechazado' : 'Pendiente';
      const clase = resultado === 'admitido' ? 'chip--success' : resultado === 'rechazado' ? 'chip--rechazado' : 'chip--pending';
      chipComite.textContent = texto;
      chipComite.className = `chip ${clase}`;
    }
    const panel = document.querySelector<HTMLElement>(`.panel[data-token="${token}"]`);
    if (panel) {
      const badge = panel.querySelector<HTMLElement>('[data-campo="resultado-badge"]');
      if (badge) {
        badge.hidden = resultado === 'pendiente';
        badge.textContent = resultado === 'admitido' ? 'Cupo admitido ✓' : resultado === 'rechazado' ? 'Cupo rechazado' : '';
      }
      const botonAprobar = panel.querySelector<HTMLButtonElement>('button[data-accion="aprobar"]');
      if (botonAprobar) botonAprobar.classList.toggle('btn--accion-activo', resultado === 'admitido');
      const botonRechazar = panel.querySelector<HTMLButtonElement>('button[data-accion="rechazar"]');
      if (botonRechazar) botonRechazar.classList.toggle('btn--accion-activo', resultado === 'rechazado');
      const dotComite = panel.querySelector<HTMLElement>('details[data-paso-id="comite_aprobo"] [data-campo="dot"]');
      if (dotComite) {
        dotComite.classList.toggle('paso__dot--completo', resultado === 'admitido');
        dotComite.textContent = resultado === 'admitido' ? '✓' : (dotComite.dataset.numero ?? '');
      }
      const estadoComite = panel.querySelector<HTMLElement>('details[data-paso-id="comite_aprobo"] [data-campo="estado"]');
      if (estadoComite) estadoComite.textContent = resultado === 'admitido' ? 'Completado' : 'Pendiente';
    }
  }

  // Aplica una corrección de datos básicos (nombre, grado, acudiente) a la
  // fila de la tabla, a la ficha y a sus campos de edición, para que los
  // tres queden de acuerdo tras guardar o tras recargar la página.
  function aplicarDatosADom(token: string, datos: DatosEditables) {
    const panel = document.querySelector<HTMLElement>(`.panel[data-token="${token}"]`);
    const fila = document.querySelector<HTMLElement>(`.tabla__fila[data-token="${token}"]`);

    const campos: { valor?: string; selectorPanel: string; selectorFila?: string; selectorInput: string }[] = [
      { valor: datos.nombre, selectorPanel: '[data-campo="nombre"]', selectorFila: '[data-campo="nombre"]', selectorInput: '[data-campo-edicion="nombre"]' },
      { valor: datos.grado, selectorPanel: '[data-campo="grado"]', selectorFila: '[data-campo="grado"]', selectorInput: '[data-campo-edicion="grado"]' },
      { valor: datos.acudienteNombre, selectorPanel: '[data-campo="acudiente-nombre"]', selectorInput: '[data-campo-edicion="acudienteNombre"]' },
      { valor: datos.acudienteTelefono, selectorPanel: '[data-campo="acudiente-telefono"]', selectorInput: '[data-campo-edicion="acudienteTelefono"]' },
    ];

    campos.forEach(({ valor, selectorPanel, selectorFila, selectorInput }) => {
      if (valor === undefined) return;
      const elPanel = panel?.querySelector<HTMLElement>(selectorPanel);
      if (elPanel) elPanel.textContent = valor;
      if (selectorFila) {
        const elFila = fila?.querySelector<HTMLElement>(selectorFila);
        if (elFila) elFila.textContent = valor;
      }
      const input = panel?.querySelector<HTMLInputElement>(selectorInput);
      if (input) input.value = valor;
    });
  }

  // "Eliminar" solo oculta la fila y la ficha en este navegador (ver la
  // nota de CambiosAspirante.eliminado en estadoAspirantes.ts). Si era el
  // aspirante activo, selecciona el que haya quedado primero para no dejar
  // la ficha vacía.
  function aplicarEliminadoADom(token: string) {
    const fila = document.querySelector<HTMLElement>(`.tabla__fila[data-token="${token}"]`);
    const panel = document.querySelector<HTMLElement>(`.panel[data-token="${token}"]`);
    const eraActiva = fila?.classList.contains('tabla__fila--activa') ?? false;
    fila?.remove();
    panel?.remove();
    if (eraActiva) {
      const siguienteFila = document.querySelector<HTMLElement>('.tabla__fila[data-index]');
      if (siguienteFila?.dataset.index !== undefined) seleccionar(siguienteFila.dataset.index);
    }
  }

  // Descarta lo escrito en el formulario de edición (sin guardar) y lo
  // vuelve a llenar con lo que hoy se ve en la ficha.
  function restablecerFormEdicion(panel: HTMLElement) {
    const valorDe = (selector: string) => panel.querySelector<HTMLElement>(selector)?.textContent ?? '';
    const ponerEn = (selector: string, valor: string) => {
      const input = panel.querySelector<HTMLInputElement>(selector);
      if (input) input.value = valor;
    };
    ponerEn('[data-campo-edicion="nombre"]', valorDe('[data-campo="nombre"]'));
    ponerEn('[data-campo-edicion="grado"]', valorDe('[data-campo="grado"]'));
    ponerEn('[data-campo-edicion="acudienteNombre"]', valorDe('[data-campo="acudiente-nombre"]'));
    ponerEn('[data-campo-edicion="acudienteTelefono"]', valorDe('[data-campo="acudiente-telefono"]'));
    const form = panel.querySelector<HTMLElement>('[data-campo="form-edicion"]');
    if (form) form.hidden = true;
  }

  function pasosBaseDe(panel: HTMLElement): PasoManual[] {
    try {
      return JSON.parse(panel.dataset.pasosBase ?? '[]');
    } catch {
      return [];
    }
  }

  // Los botones "Admitir estudiante" / "Rechazar cupo" solo deben poder
  // usarse cuando ya se completaron los pasos anteriores (formulario en
  // físico, pago confirmado por Q10, papelería entregada). Se recalcula
  // cada vez que cambia un checkbox de esos pasos.
  function actualizarBotonesComite(panel: HTMLElement) {
    const detalles = panel.querySelectorAll<HTMLElement>('details[data-paso-id]');
    let todosPrevios = true;
    detalles.forEach((detalle) => {
      if (detalle.dataset.pasoId === 'comite_aprobo') return;
      const checkbox = detalle.querySelector<HTMLInputElement>('input[type="checkbox"]');
      const dot = detalle.querySelector<HTMLElement>('[data-campo="dot"]');
      const completado = checkbox ? checkbox.checked : (dot?.classList.contains('paso__dot--completo') ?? false);
      if (!completado) todosPrevios = false;
    });
    const botonAprobar = panel.querySelector<HTMLButtonElement>('button[data-accion="aprobar"]');
    const botonRechazar = panel.querySelector<HTMLButtonElement>('button[data-accion="rechazar"]');
    if (botonAprobar) botonAprobar.disabled = !todosPrevios;
    if (botonRechazar) botonRechazar.disabled = !todosPrevios;
    const nota = panel.querySelector<HTMLElement>('[data-campo="nota-bloqueo"]');
    if (nota) nota.hidden = todosPrevios;
  }

  // Al cargar: si en este navegador ya se guardó algún cambio para un
  // aspirante, se aplica encima de lo que vino del build.
  document.querySelectorAll<HTMLElement>('.panel[data-token]').forEach((panel) => {
    const token = panel.dataset.token;
    if (!token) return;
    const cambios = leerCambios(token);
    if (cambios) {
      cambios.pasos?.forEach((p) => aplicarPasoADom(token, p.id, p.completado));
      if (cambios.resultado) aplicarResultadoADom(token, cambios.resultado);
      if (cambios.datos) aplicarDatosADom(token, cambios.datos);
      if (cambios.archivos) {
        Object.entries(cambios.archivos).forEach(([pasoId, nombre]) => {
          if (nombre) aplicarArchivoADom(token, pasoId as PasoManual['id'], nombre);
        });
      }
      if (cambios.eliminado) {
        aplicarEliminadoADom(token);
        return;
      }
    }
    // Se recalcula siempre (haya o no cambios guardados) para que el
    // estado inicial de los botones quede acorde a lo que se ve en pantalla.
    actualizarBotonesComite(panel);
  });

  // Checkbox del paso "documento" (formulario / papelería recibidos en
  // físico): además de guardar el cambio, puede habilitar o deshabilitar
  // los botones de admitir/rechazar del mismo panel. Delegado en el
  // documento para que también funcione con los paneles agregados arriba.
  document.addEventListener('change', (evento) => {
    const input = (evento.target as HTMLElement).closest<HTMLInputElement>('input[data-token][data-paso-id]');
    if (!input) return;

    const token = input.dataset.token!;
    const pasoId = input.dataset.pasoId as PasoManual['id'];
    const completado = input.checked;
    const panel = input.closest<HTMLElement>('.panel[data-token]');
    if (!panel) return;

    actualizarPaso(token, pasosBaseDe(panel), pasoId, completado);
    aplicarPasoADom(token, pasoId, completado);
    actualizarBotonesComite(panel);
  });

  // "Subir archivo" es una simulación (no hay backend real todavía, ver el
  // TODO(servidor) de estadoAspirantes.ts): elegir un archivo lo guarda por
  // su nombre, lo muestra en la ficha y marca el paso como recibido, igual
  // que si alguien hubiera marcado el checkbox a mano.
  document.addEventListener('change', (evento) => {
    const input = (evento.target as HTMLElement).closest<HTMLInputElement>('input[data-input-archivo]');
    if (!input || !input.files || input.files.length === 0) return;

    const token = input.dataset.token!;
    const pasoId = input.dataset.pasoId as PasoManual['id'];
    const nombreArchivo = input.files[0].name;
    const panel = document.querySelector<HTMLElement>(`.panel[data-token="${token}"]`);
    if (!panel) return;

    actualizarArchivo(token, pasoId, nombreArchivo);
    aplicarArchivoADom(token, pasoId, nombreArchivo);

    const checkbox = panel.querySelector<HTMLInputElement>(`input[type="checkbox"][data-paso-id="${pasoId}"]`);
    if (checkbox && !checkbox.checked) {
      checkbox.checked = true;
      actualizarPaso(token, pasosBaseDe(panel), pasoId, true);
      aplicarPasoADom(token, pasoId, true);
      actualizarBotonesComite(panel);
    }
  });

  // Botones "Admitir estudiante" y "Rechazar cupo": las dos salidas
  // posibles del proceso. Quedan deshabilitados (ver actualizarBotonesComite)
  // hasta que los pasos anteriores estén completos.
  document.addEventListener('click', (evento) => {
    const objetivo = evento.target as HTMLElement;

    const botonAprobar = objetivo.closest<HTMLButtonElement>('button[data-accion="aprobar"]');
    if (botonAprobar) {
      const token = botonAprobar.dataset.token!;
      const panel = botonAprobar.closest<HTMLElement>('.panel[data-token]');
      if (!panel) return;
      actualizarPaso(token, pasosBaseDe(panel), 'comite_aprobo', true);
      actualizarResultado(token, 'admitido');
      aplicarPasoADom(token, 'comite_aprobo', true);
      aplicarResultadoADom(token, 'admitido');
      return;
    }

    const botonRechazar = objetivo.closest<HTMLButtonElement>('button[data-accion="rechazar"]');
    if (botonRechazar) {
      const token = botonRechazar.dataset.token!;
      const panel = botonRechazar.closest<HTMLElement>('.panel[data-token]');
      if (!panel) return;
      actualizarPaso(token, pasosBaseDe(panel), 'comite_aprobo', false);
      actualizarResultado(token, 'rechazado');
      aplicarPasoADom(token, 'comite_aprobo', false);
      aplicarResultadoADom(token, 'rechazado');
      return;
    }

    // Botón "Simular: marcar como pagado/no pagado" del paso automático
    // (Q10): invierte el estado guardado, temporalmente, mientras no existe
    // la conexión real — ver la nota junto al botón en la ficha.
    const botonSimularPago = objetivo.closest<HTMLButtonElement>('button[data-accion="simular-pago"]');
    if (botonSimularPago) {
      const token = botonSimularPago.dataset.token!;
      const pasoId = botonSimularPago.dataset.pasoId as PasoManual['id'];
      const panel = document.querySelector<HTMLElement>(`.panel[data-token="${token}"]`);
      if (!panel) return;
      const completadoActual = botonSimularPago.dataset.completado === 'true';
      const nuevoCompletado = !completadoActual;
      actualizarPaso(token, pasosBaseDe(panel), pasoId, nuevoCompletado);
      aplicarPasoADom(token, pasoId, nuevoCompletado);
      actualizarBotonesComite(panel);
      return;
    }

    // "Subir archivo" abre el selector de archivos oculto asociado a ese
    // paso (el input real está oculto porque no se puede estilar).
    const botonSubirArchivo = objetivo.closest<HTMLButtonElement>('button[data-accion="subir-archivo"]');
    if (botonSubirArchivo) {
      const token = botonSubirArchivo.dataset.token;
      const pasoId = botonSubirArchivo.dataset.pasoId;
      const input = document.querySelector<HTMLInputElement>(
        `input[data-input-archivo="${pasoId}"][data-token="${token}"]`
      );
      input?.click();
      return;
    }

    // "Editar datos" y "Eliminar aspirante" pueden venir de dos lugares: el
    // botón dentro de la ficha (que ya está dentro de `.panel`) o el icono
    // al lado de la fila en la tabla (que no lo está) — por eso se busca el
    // panel siempre por token, no por closest('.panel'), para que funcione
    // desde cualquiera de los dos.
    const botonEditar = objetivo.closest<HTMLButtonElement>('button[data-accion="editar"]');
    if (botonEditar) {
      const token = botonEditar.dataset.token!;
      const fila = document.querySelector<HTMLElement>(`.tabla__fila[data-token="${token}"]`);
      if (fila?.dataset.index !== undefined) seleccionar(fila.dataset.index);
      const panel = document.querySelector<HTMLElement>(`.panel[data-token="${token}"]`);
      const form = panel?.querySelector<HTMLElement>('[data-campo="form-edicion"]');
      if (form) form.hidden = !form.hidden;
      return;
    }

    const botonCancelar = objetivo.closest<HTMLButtonElement>('button[data-accion="cancelar-edicion"]');
    if (botonCancelar) {
      const panel = botonCancelar.closest<HTMLElement>('.panel[data-token]');
      if (panel) restablecerFormEdicion(panel);
      return;
    }

    const botonGuardar = objetivo.closest<HTMLButtonElement>('button[data-accion="guardar-edicion"]');
    if (botonGuardar) {
      const token = botonGuardar.dataset.token!;
      const panel = botonGuardar.closest<HTMLElement>('.panel[data-token]');
      if (!panel) return;
      const leer = (selector: string) => panel.querySelector<HTMLInputElement>(selector)?.value.trim() ?? '';
      const datos: DatosEditables = {
        nombre: leer('[data-campo-edicion="nombre"]'),
        grado: leer('[data-campo-edicion="grado"]'),
        acudienteNombre: leer('[data-campo-edicion="acudienteNombre"]'),
        acudienteTelefono: leer('[data-campo-edicion="acudienteTelefono"]'),
      };
      actualizarDatos(token, datos);
      aplicarDatosADom(token, datos);
      const form = panel.querySelector<HTMLElement>('[data-campo="form-edicion"]');
      if (form) form.hidden = true;
      return;
    }

    // "Eliminar aspirante": se pide confirmación porque no se puede
    // deshacer desde la interfaz (habría que volver a marcar "olvidar" a
    // mano en el navegador). Ver la nota de CambiosAspirante.eliminado.
    const botonEliminar = objetivo.closest<HTMLButtonElement>('button[data-accion="eliminar"]');
    if (botonEliminar) {
      const token = botonEliminar.dataset.token!;
      const fila = document.querySelector<HTMLElement>(`.tabla__fila[data-token="${token}"]`);
      const panel = document.querySelector<HTMLElement>(`.panel[data-token="${token}"]`);
      const nombre =
        fila?.querySelector<HTMLElement>('[data-campo="nombre"]')?.textContent ||
        panel?.querySelector<HTMLElement>('[data-campo="nombre"]')?.textContent ||
        'este aspirante';
      const confirmado = window.confirm(`¿Eliminar a ${nombre}? Esta acción solo lo oculta en este navegador.`);
      if (!confirmado) return;
      marcarEliminado(token);
      aplicarEliminadoADom(token);
    }
  });

  // --- Pestaña "Citas agendadas" ---
  //
  // Junta la cita (proximaCita) de TODOS los aspirantes — los del build y
  // los agendados desde /admisiones/cita — y las agrupa por fecha y por
  // horario/título, para que una reunión grupal (varias familias en el
  // mismo horario) aparezca como un solo bloque en vez de filas sueltas.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tabs__boton');
  const vistaAspirantes = document.getElementById('vista-aspirantes') as HTMLElement;
  const vistaCitas = document.getElementById('vista-citas') as HTMLElement;
  const citasBuscador = document.getElementById('citas-buscador') as HTMLInputElement;
  const citasLista = document.getElementById('citas-lista') as HTMLElement;

  const MESES: Record<string, number> = {
    enero: 0, febrero: 1, marzo: 2, abril: 3, mayo: 4, junio: 5,
    julio: 6, agosto: 7, septiembre: 8, octubre: 9, noviembre: 10, diciembre: 11,
  };

  // Fecha en la que ordenar el día: usa fechaISO cuando existe (las citas
  // agendadas desde el formulario siempre la traen); si no (datos de
  // ejemplo más viejos), intenta leerla del texto legible asumiendo el año
  // actual — suficiente para esta maqueta, ver el TODO(servidor) de
  // nuevosAspirantes.ts para la versión real.
  function fechaOrdenableDe(cita: { fecha: string; fechaISO?: string }): Date {
    if (cita.fechaISO) return new Date(`${cita.fechaISO}T00:00:00`);
    const m = cita.fecha.match(/(\d{1,2}) de (\p{L}+)/u);
    if (m) {
      const mesIdx = MESES[m[2].toLowerCase()];
      if (mesIdx !== undefined) return new Date(new Date().getFullYear(), mesIdx, Number(m[1]));
    }
    return new Date(8640000000000000); // sin fecha reconocible: se muestra al final
  }

  function minutosDeHora(horaTexto: string): number {
    const m = horaTexto.match(/(\d{1,2}):(\d{2})\s*(a\.m\.|p\.m\.|m\b)/i);
    if (!m) return 0;
    let h = Number(m[1]);
    const min = Number(m[2]);
    const sufijo = m[3].toLowerCase();
    if (sufijo === 'm') h = 12; // "12:00 m" = mediodía
    else if (sufijo.startsWith('p') && h !== 12) h += 12;
    else if (sufijo.startsWith('a') && h === 12) h = 0;
    return h * 60 + min;
  }

  // Aplica encima del aspirante los cambios guardados por secretaría
  // (nombre/grado/acudiente editados) para que la agenda muestre lo mismo
  // que ya se ve en la tabla y la ficha — y descarta los eliminados.
  function datosVisiblesDe(a: Aspirante): Aspirante | null {
    const cambios = leerCambios(a.token);
    if (cambios?.eliminado) return null;
    if (!cambios?.datos) return a;
    const d = cambios.datos;
    return {
      ...a,
      nombre: d.nombre ?? a.nombre,
      grado: d.grado ?? a.grado,
      acudiente: {
        ...a.acudiente,
        nombre: d.acudienteNombre ?? a.acudiente.nombre,
        telefono: d.acudienteTelefono ?? a.acudiente.telefono,
      },
    };
  }

  function aspirantesConCita(): Aspirante[] {
    const todos = [...aspirantesTabla, ...leerNuevosAspirantes()];
    return todos
      .map(datosVisiblesDe)
      .filter((a): a is Aspirante => a !== null && a.proximaCita !== null);
  }

  interface SubgrupoCita {
    horaTexto: string;
    titulo: string;
    ordenHora: number;
    aspirantes: Aspirante[];
  }
  interface DiaCitas {
    fechaTexto: string;
    orden: Date;
    subgrupos: SubgrupoCita[];
  }

  // Primer nivel de agrupación: por fecha (texto legible completo, ej.
  // "Jueves 25 de septiembre"). Segundo nivel: por horario + título de la
  // cita (así "Reunión grupal de admisión · 7:30 a.m." junta a todas las
  // familias de esa franja, y una cita individual queda en su propio
  // bloque de un solo nombre).
  function construirAgenda(lista: Aspirante[]): DiaCitas[] {
    const porFecha = new Map<string, { fechaTexto: string; orden: Date; subgrupos: Map<string, SubgrupoCita> }>();

    lista.forEach((a) => {
      const cita = a.proximaCita!;
      const [fechaTexto, horaTexto = ''] = cita.fecha.split(' · ');
      if (!porFecha.has(fechaTexto)) {
        porFecha.set(fechaTexto, { fechaTexto, orden: fechaOrdenableDe(cita), subgrupos: new Map() });
      }
      const dia = porFecha.get(fechaTexto)!;
      const claveSub = `${horaTexto}||${cita.titulo}`;
      if (!dia.subgrupos.has(claveSub)) {
        dia.subgrupos.set(claveSub, { horaTexto, titulo: cita.titulo, ordenHora: minutosDeHora(horaTexto), aspirantes: [] });
      }
      dia.subgrupos.get(claveSub)!.aspirantes.push(a);
    });

    return Array.from(porFecha.values())
      .sort((d1, d2) => d1.orden.getTime() - d2.orden.getTime())
      .map((dia) => ({
        fechaTexto: dia.fechaTexto,
        orden: dia.orden,
        subgrupos: Array.from(dia.subgrupos.values()).sort((s1, s2) => s1.ordenHora - s2.ordenHora),
      }));
  }

  function pintarCitas() {
    const filtro = citasBuscador.value.trim().toLowerCase();
    let lista = aspirantesConCita();
    if (filtro) {
      lista = lista.filter(
        (a) =>
          a.nombre.toLowerCase().includes(filtro) ||
          a.acudiente.nombre.toLowerCase().includes(filtro) ||
          a.grado.toLowerCase().includes(filtro)
      );
    }

    const agenda = construirAgenda(lista);
    citasLista.innerHTML = '';

    if (agenda.length === 0) {
      citasLista.innerHTML = '<p class="citas__vacio">No hay citas agendadas que coincidan con la búsqueda.</p>';
      return;
    }

    agenda.forEach((dia) => {
      const totalCitas = dia.subgrupos.reduce((n, s) => n + s.aspirantes.length, 0);
      const bloque = document.createElement('div');
      bloque.className = 'citas__dia';
      bloque.innerHTML = `
        <div class="citas__dia-header">
          <span class="citas__dia-fecha">${escapeHtml(dia.fechaTexto)}</span>
          <span class="citas__dia-conteo">${totalCitas} cita${totalCitas === 1 ? '' : 's'}</span>
        </div>
      `;
      dia.subgrupos.forEach((sub) => {
        const grupo = document.createElement('div');
        grupo.className = 'citas__grupo';
        grupo.innerHTML = `
          <div class="citas__grupo-header">
            <span class="citas__grupo-hora">${escapeHtml(sub.horaTexto)}</span>
            <span class="citas__grupo-titulo">${escapeHtml(sub.titulo)}</span>
            ${sub.aspirantes.length > 1 ? `<span class="chip chip--pending">${sub.aspirantes.length} familias</span>` : ''}
          </div>
          <div class="citas__familias">
            ${sub.aspirantes
              .map(
                (a) => `
              <div class="citas__familia">
                <span class="citas__familia-nombre">${escapeHtml(a.nombre)}</span>
                <span class="citas__familia-grado">${escapeHtml(a.grado)}</span>
                <span class="citas__familia-acudiente">Acudiente: ${escapeHtml(a.acudiente.nombre)}</span>
              </div>
            `
              )
              .join('')}
          </div>
        `;
        bloque.appendChild(grupo);
      });
      citasLista.appendChild(bloque);
    });

    // citas-lista ya trae el atributo de scope de Astro (viene del build);
    // se lo copiamos a todo lo que acabamos de crear a mano con JS, igual
    // que con las filas/paneles nuevos — si no, se ven sin estilo.
    copiarCidAstro('#citas-lista', citasLista);
  }

  tabs.forEach((boton) => {
    boton.addEventListener('click', () => {
      tabs.forEach((b) => {
        b.classList.toggle('tabs__boton--activo', b === boton);
        b.setAttribute('aria-selected', String(b === boton));
      });
      const esCitas = boton.dataset.tab === 'citas';
      vistaAspirantes.hidden = esCitas;
      vistaCitas.hidden = !esCitas;
      if (esCitas) pintarCitas();
    });
  });

  citasBuscador.addEventListener('input', pintarCitas);
</script>

<style>
  .page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 24px 24px 24px;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 48px);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
    flex: 1;
    min-height: 0;
  }
  /* Igual que en otros componentes del módulo: la clase con scope de Astro
     (display:...) le gana en especificidad a la regla nativa
     `[hidden]{display:none}` — hay que forzarla aquí. */
  .grid[hidden] {
    display: none;
  }
  .grid__right {
    min-height: 0;
  }

  .tabs {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
  }
  .tabs__boton {
    border: none;
    background: transparent;
    padding: 9px 16px;
    border-radius: 6px 6px 0 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-faint);
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }
  .tabs__boton:hover {
    color: var(--text);
  }
  .tabs__boton--activo {
    color: var(--terracota);
    border-bottom-color: var(--terracota);
  }

  .citas {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }
  .citas[hidden] {
    display: none;
  }
  .citas__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }
  .citas__titulo {
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
  }
  .citas__subtitulo {
    margin: 4px 0 0;
    font-size: 12.5px;
    color: var(--text-muted);
    max-width: 480px;
    line-height: 1.5;
  }
  .citas__buscador {
    border: 1px solid #dcd9cf;
    border-radius: 4px;
    padding: 9px 12px;
    font-size: 13px;
    min-width: 240px;

---
// Panel interno de secretaría.
// TODO(servidor): esta ruta debe quedar detrás de autenticación real
// (usuario/contraseña), a diferencia del acceso ligero de los padres.
// Los checkboxes y el botón de envío deben pegar a endpoints propios que
// actualicen el estado en la base / Q10 y disparen el envío de WhatsApp.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ApplicantsTable from '../../components/admisiones/ApplicantsTable.astro';
import PanelAspirante from '../../components/admisiones/PanelAspirante.astro';
import { aspirantesTabla } from '../../data/mockSecretaria';
---

<BaseLayout title="Panel de secretaría">
  <main class="page">
    <div class="grid">
      <ApplicantsTable filas={aspirantesTabla} />

      <div class="grid__right">
        {
          aspirantesTabla.map((f, i) => (
            <PanelAspirante aspirante={f} index={i} activo={i === 0} urlPortalPadre={`/admisiones/seguimiento/${f.token}`} />
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import type { PasoManual, ResultadoAdmision } from '../../data/types';
  import { actualizarPaso, actualizarResultado, leerCambios } from '../../scripts/estadoAspirantes';

  // Coordina la tabla de aspirantes (izquierda) con su ficha de detalle
  // (derecha): al hacer clic o navegar con teclado a una fila, se muestra
  // el <PanelAspirante> que le corresponde y se oculta el resto.
  const filas = document.querySelectorAll<HTMLElement>('.tabla__fila[data-index]');
  const paneles = document.querySelectorAll<HTMLElement>('.panel[data-panel-index]');

  function seleccionar(indice: string) {
    filas.forEach((fila) => {
      fila.classList.toggle('tabla__fila--activa', fila.dataset.index === indice);
    });
    paneles.forEach((panel) => {
      panel.hidden = panel.dataset.panelIndex !== indice;
    });
  }

  filas.forEach((fila) => {
    fila.addEventListener('click', () => {
      if (fila.dataset.index !== undefined) seleccionar(fila.dataset.index);
    });
    fila.addEventListener('keydown', (evento) => {
      const e = evento as KeyboardEvent;
      if ((e.key === 'Enter' || e.key === ' ') && fila.dataset.index !== undefined) {
        e.preventDefault();
        seleccionar(fila.dataset.index);
      }
    });
  });

  // --- Interconexión con el portal del padre (simulada con localStorage) ---
  //
  // Esto es una MAQUETA de lo que hará el backend real: cada cambio que
  // hace secretaría aquí se guarda en el navegador, y el portal del padre
  // (/admisiones/seguimiento/<token>) lee esos mismos cambios al abrirse.
  // Solo funciona probando ambas páginas en el mismo navegador — para que
  // funcione entre dispositivos distintos hace falta el backend real
  // (ver TODO(servidor) en estadoAspirantes.ts).

  function aplicarPasoADom(token: string, pasoId: PasoManual['id'], completado: boolean) {
    const detalle = document.querySelector<HTMLDetailsElement>(
      `.panel[data-token="${token}"] details[data-paso-id="${pasoId}"]`
    );
    if (detalle) {
      const checkbox = detalle.querySelector<HTMLInputElement>(`input[data-paso-id="${pasoId}"]`);
      if (checkbox) checkbox.checked = completado;
      const dot = detalle.querySelector<HTMLElement>('[data-campo="dot"]');
      if (dot) {
        dot.classList.toggle('paso__dot--completo', completado);
        dot.textContent = completado ? '✓' : (dot.dataset.numero ?? '');
      }
      const estado = detalle.querySelector<HTMLElement>('[data-campo="estado"]');
      if (estado) estado.textContent = completado ? 'Completado' : 'Pendiente';
    }
    if (pasoId === 'formulario_pagado') {
      const chip = document.querySelector<HTMLElement>(`.tabla__fila[data-token="${token}"] [data-campo="formulario"]`);
      if (chip) {
        chip.textContent = completado ? 'Pagado' : 'Pendiente';
        chip.className = `chip ${completado ? 'chip--success' : 'chip--pending'}`;
      }
    }
  }

  function aplicarResultadoADom(token: string, resultado: ResultadoAdmision) {
    const chipComite = document.querySelector<HTMLElement>(`.tabla__fila[data-token="${token}"] [data-campo="comite"]`);
    if (chipComite) {
      const texto = resultado === 'admitido' ? 'Aprobado' : resultado === 'rechazado' ? 'Rechazado' : 'Pendiente';
      const clase = resultado === 'admitido' ? 'chip--success' : resultado === 'rechazado' ? 'chip--rechazado' : 'chip--pending';
      chipComite.textContent = texto;
      chipComite.className = `chip ${clase}`;
    }
    const panel = document.querySelector<HTMLElement>(`.panel[data-token="${token}"]`);
    if (panel) {
      const badge = panel.querySelector<HTMLElement>('[data-campo="resultado-badge"]');
      if (badge) {
        badge.hidden = resultado === 'pendiente';
        badge.textContent = resultado === 'admitido' ? 'Cupo admitido ✓' : resultado === 'rechazado' ? 'Cupo rechazado' : '';
      }
      const botonAprobar = panel.querySelector<HTMLButtonElement>('button[data-accion="aprobar"]');
      if (botonAprobar) botonAprobar.classList.toggle('btn--accion-activo', resultado === 'admitido');
      const botonRechazar = panel.querySelector<HTMLButtonElement>('button[data-accion="rechazar"]');
      if (botonRechazar) botonRechazar.classList.toggle('btn--accion-activo', resultado === 'rechazado');
      const dotComite = panel.querySelector<HTMLElement>('details[data-paso-id="comite_aprobo"] [data-campo="dot"]');
      if (dotComite) {
        dotComite.classList.toggle('paso__dot--completo', resultado === 'admitido');
        dotComite.textContent = resultado === 'admitido' ? '✓' : (dotComite.dataset.numero ?? '');
      }
      const estadoComite = panel.querySelector<HTMLElement>('details[data-paso-id="comite_aprobo"] [data-campo="estado"]');
      if (estadoComite) estadoComite.textContent = resultado === 'admitido' ? 'Completado' : 'Pendiente';
    }
  }

  function pasosBaseDe(panel: HTMLElement): PasoManual[] {
    try {
      return JSON.parse(panel.dataset.pasosBase ?? '[]');
    } catch {
      return [];
    }
  }

  // Los botones "Admitir estudiante" / "Rechazar cupo" solo deben poder
  // usarse cuando ya se completaron los pasos anteriores (formulario en
  // físico, pago confirmado por Q10, papelería entregada). Se recalcula
  // cada vez que cambia un checkbox de esos pasos.
  function actualizarBotonesComite(panel: HTMLElement) {
    const detalles = panel.querySelectorAll<HTMLElement>('details[data-paso-id]');
    let todosPrevios = true;
    detalles.forEach((detalle) => {
      if (detalle.dataset.pasoId === 'comite_aprobo') return;
      const checkbox = detalle.querySelector<HTMLInputElement>('input[type="checkbox"]');
      const dot = detalle.querySelector<HTMLElement>('[data-campo="dot"]');
      const completado = checkbox ? checkbox.checked : (dot?.classList.contains('paso__dot--completo') ?? false);
      if (!completado) todosPrevios = false;
    });
    const botonAprobar = panel.querySelector<HTMLButtonElement>('button[data-accion="aprobar"]');
    const botonRechazar = panel.querySelector<HTMLButtonElement>('button[data-accion="rechazar"]');
    if (botonAprobar) botonAprobar.disabled = !todosPrevios;
    if (botonRechazar) botonRechazar.disabled = !todosPrevios;
    const nota = panel.querySelector<HTMLElement>('[data-campo="nota-bloqueo"]');
    if (nota) nota.hidden = todosPrevios;
  }

  // Al cargar: si en este navegador ya se guardó algún cambio para un
  // aspirante, se aplica encima de lo que vino del build.
  document.querySelectorAll<HTMLElement>('.panel[data-token]').forEach((panel) => {
    const token = panel.dataset.token;
    if (!token) return;
    const cambios = leerCambios(token);
    if (cambios) {
      cambios.pasos?.forEach((p) => aplicarPasoADom(token, p.id, p.completado));
      if (cambios.resultado) aplicarResultadoADom(token, cambios.resultado);
    }
    // Se recalcula siempre (haya o no cambios guardados) para que el
    // estado inicial de los botones quede acorde a lo que se ve en pantalla.
    actualizarBotonesComite(panel);
  });

  // Checkbox del paso "documento" (formulario / papelería recibidos en
  // físico): además de guardar el cambio, puede habilitar o deshabilitar
  // los botones de admitir/rechazar del mismo panel.
  document.querySelectorAll<HTMLInputElement>('input[data-token][data-paso-id]').forEach((input) => {
    input.addEventListener('change', () => {
      const token = input.dataset.token!;
      const pasoId = input.dataset.pasoId as PasoManual['id'];
      const completado = input.checked;
      const panel = input.closest<HTMLElement>('.panel[data-token]');
      if (!panel) return;

      actualizarPaso(token, pasosBaseDe(panel), pasoId, completado);
      aplicarPasoADom(token, pasoId, completado);
      actualizarBotonesComite(panel);
    });
  });

  // Botones "Admitir estudiante" y "Rechazar cupo": las dos salidas
  // posibles del proceso. Quedan deshabilitados (ver actualizarBotonesComite)
  // hasta que los pasos anteriores estén completos.
  document.querySelectorAll<HTMLButtonElement>('button[data-accion="aprobar"]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const token = boton.dataset.token!;
      const panel = boton.closest<HTMLElement>('.panel[data-token]');
      if (!panel) return;

      actualizarPaso(token, pasosBaseDe(panel), 'comite_aprobo', true);
      actualizarResultado(token, 'admitido');
      aplicarPasoADom(token, 'comite_aprobo', true);
      aplicarResultadoADom(token, 'admitido');
    });
  });

  document.querySelectorAll<HTMLButtonElement>('button[data-accion="rechazar"]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const token = boton.dataset.token!;
      const panel = boton.closest<HTMLElement>('.panel[data-token]');
      if (!panel) return;

      actualizarPaso(token, pasosBaseDe(panel), 'comite_aprobo', false);
      actualizarResultado(token, 'rechazado');
      aplicarPasoADom(token, 'comite_aprobo', false);
      aplicarResultadoADom(token, 'rechazado');
    });
  });
</script>

<style>
  .page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 24px 24px 24px;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 48px);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
    flex: 1;
    min-height: 0;
  }
  .grid__right {
    min-height: 0;
  }

  @media (max-width: 900px) {
    .page {
      min-height: 0;
    }
    .grid {
      grid-template-columns: 1fr;
      flex: none;
    }
    .tabla {
      height: auto;
    }
  }
</style>

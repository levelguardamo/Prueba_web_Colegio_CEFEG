---
import type { Aspirante } from '../../data/types';

interface Props {
  cita: NonNullable<Aspirante['proximaCita']>;
}
const { cita } = Astro.props;
---

<div class="card">
  <div class="eyebrow">Próxima cita</div>
  <div class="serif cita__titulo">{cita.titulo}</div>
  <div class="cita__linea">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a93a3" stroke-width="2">
      <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" />
    </svg>
    {cita.fecha}
  </div>
  <div class="cita__linea">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a93a3" stroke-width="2">
      <path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z" /><circle cx="12" cy="10" r="3" />
    </svg>
    {cita.lugar}
  </div>
  <div class="cita__acciones">
    <button class="btn btn--primary" style="flex:1" type="button">Reagendar cita</button>
  </div>
  <div class="cita__nota">{cita.notaSincronizacion}</div>
</div>

<style>
  .eyebrow {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--terracota);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .cita__titulo {
    font-size: 19px;
    font-weight: 700;
    color: var(--navy);
  }
  .cita__linea {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: 14px;
    color: #3b4457;
  }
  .cita__acciones {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }
  .cita__nota {
    margin-top: 12px;
    font-size: 11.5px;
    color: var(--text-faint);
  }
</style>

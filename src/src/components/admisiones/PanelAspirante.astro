---
// Panel de detalle de UN aspirante, para el lado derecho del panel de
// secretaría. Reemplaza el viejo formulario de checkboxes por una línea
// de progreso: cada paso es un <details> — el punto y la etiqueta son el
// <summary>, así que darle clic al punto abre la acción de ese paso
// (subir archivo / marcar recibido en físico / aprobar el cupo).
//
// Se renderiza uno de estos por cada aspirante de la tabla, y un script
// en la página (secretaria/admisiones.astro) muestra/oculta el que
// corresponda al hacer clic en una fila de la tabla — por eso recibe
// `activo` y queda oculto con el atributo `hidden` cuando no le toca.
//
// TODO(servidor): los checkboxes y "Subir archivo" deben pegar a
// endpoints propios que actualicen el estado en la base / Q10. Marcar
// "Comité aprobó el cupo" es lo que debe disparar, del lado del
// servidor, el mensaje de bienvenida automático (portal + WhatsApp) —
// ya no hay un botón manual de "enviar bienvenida" en esta pantalla.
import type { Aspirante } from '../../data/types';

interface Props {
  aspirante: Aspirante;
  index: number;
  activo: boolean;
  urlPortalPadre?: string;
}
const { aspirante, index, activo, urlPortalPadre } = Astro.props;

// Por defecto se abre el primer paso que aún falta, para que secretaría
// vea de una qué sigue pendiente.
const indiceAbierto = aspirante.pasos.findIndex((p) => !p.completado);

// Admitir o rechazar el cupo es la última decisión del proceso — no debe
// poder tomarse si todavía faltan pasos anteriores (formulario en físico,
// pago confirmado por Q10, papelería entregada). Mientras falte alguno,
// los dos botones quedan deshabilitados.
const pasosPrevios = aspirante.pasos.filter((p) => p.id !== 'comite_aprobo');
const todosPreviosCompletos = pasosPrevios.every((p) => p.completado);
---

<div
  class="panel card"
  data-panel-index={index}
  data-token={aspirante.token}
  data-pasos-base={JSON.stringify(aspirante.pasos)}
  hidden={!activo}
>
  <div class="panel__header">
    <div class="panel__header-top">
      <div>
        <div class="eyebrow">Ficha del aspirante</div>
        <div class="serif panel__nombre" data-campo="nombre">{aspirante.nombre}</div>
        <div class="panel__grado" data-campo="grado">{aspirante.grado}</div>
      </div>
      <div class="panel__header-acciones">
        <button class="btn btn--outline btn--accion" type="button" data-token={aspirante.token} data-accion="editar">
          Editar datos
        </button>
        <button class="btn btn--outline btn--accion btn--peligro" type="button" data-token={aspirante.token} data-accion="eliminar">
          Eliminar aspirante
        </button>
      </div>
    </div>
    <div class="panel__resultado" data-campo="resultado-badge" hidden={aspirante.resultado === 'pendiente'}>
      {aspirante.resultado === 'admitido' ? 'Cupo admitido ✓' : aspirante.resultado === 'rechazado' ? 'Cupo rechazado' : ''}
    </div>

    <div class="panel__edicion" data-campo="form-edicion" hidden>
      <label class="campo-edicion">
        <span>Nombre del aspirante</span>
        <input type="text" data-campo-edicion="nombre" value={aspirante.nombre} />
      </label>
      <label class="campo-edicion">
        <span>Grado</span>
        <input type="text" data-campo-edicion="grado" value={aspirante.grado} />
      </label>
      <label class="campo-edicion">
        <span>Nombre del acudiente</span>
        <input type="text" data-campo-edicion="acudienteNombre" value={aspirante.acudiente.nombre} />
      </label>
      <label class="campo-edicion">
        <span>Teléfono del acudiente</span>
        <input type="text" data-campo-edicion="acudienteTelefono" value={aspirante.acudiente.telefono} />
      </label>
      <div class="panel__edicion-botones">
        <button class="btn btn--accent" type="button" data-token={aspirante.token} data-accion="guardar-edicion">
          Guardar cambios
        </button>
        <button class="btn btn--outline" type="button" data-accion="cancelar-edicion">Cancelar</button>
      </div>
    </div>
  </div>

  <div class="progreso">
    {
      aspirante.pasos.map((paso, i) => (
        <details class="paso" data-paso-id={paso.id} open={i === indiceAbierto}>
          <summary class="paso__resumen">
            <span class={`paso__dot ${paso.completado ? 'paso__dot--completo' : ''}`} data-campo="dot" data-numero={i + 1}>
              {paso.completado ? '✓' : i + 1}
            </span>
            <span class="paso__texto">
              <span class="paso__label">{paso.label}</span>
              <span class="paso__estado" data-campo="estado">
                {paso.tipo === 'automatico'
                  ? paso.completado
                    ? 'Confirmado por Q10'
                    : 'Aún no confirma Q10'
                  : paso.completado
                    ? 'Completado'
                    : 'Pendiente'}
              </span>
            </span>
          </summary>

          <div class="paso__acciones">
            {paso.tipo === 'documento' && (
              <>
                <label class="check">
                  <input type="checkbox" checked={paso.completado} data-token={aspirante.token} data-paso-id={paso.id} />
                  Marcar como recibido en físico
                </label>
                <button class="btn btn--outline" type="button">
                  Subir archivo
                </button>
              </>
            )}
            {paso.tipo === 'automatico' && (
              <span class={`chip ${paso.completado ? 'chip--success' : 'chip--pending'}`}>
                {paso.completado ? 'Confirmado automáticamente por Q10' : 'Q10 todavía no confirma el pago'}
              </span>
            )}
            {paso.tipo === 'aprobacion' && (
              <>
                <div class="comite-acciones">
                  <button
                    class={`btn btn--outline btn--accion btn--accion-aprobar ${aspirante.resultado === 'admitido' ? 'btn--accion-activo' : ''}`}
                    type="button"
                    data-token={aspirante.token}
                    data-accion="aprobar"
                    disabled={!todosPreviosCompletos}
                    title={!todosPreviosCompletos ? 'Completa los pasos anteriores primero' : undefined}
                  >
                    Admitir estudiante
                  </button>
                  <button
                    class={`btn btn--outline btn--accion btn--accion-rechazar ${aspirante.resultado === 'rechazado' ? 'btn--accion-activo' : ''}`}
                    type="button"
                    data-token={aspirante.token}
                    data-accion="rechazar"
                    disabled={!todosPreviosCompletos}
                    title={!todosPreviosCompletos ? 'Completa los pasos anteriores primero' : undefined}
                  >
                    Rechazar cupo
                  </button>
                </div>
                <p class="paso__nota" data-campo="nota-bloqueo" hidden={todosPreviosCompletos}>
                  Falta completar los pasos anteriores (formulario en físico, pago y papelería) antes de poder
                  admitir o rechazar el cupo.
                </p>
                <p class="paso__nota">
                  Al admitir se envía sola la bienvenida — el popup en el portal del padre y el mensaje
                  de WhatsApp, sin necesidad de hacerlo a mano desde aquí. (En esta prueba, el "envío" se
                  simula guardando el estado en este navegador — abre el portal del padre en la misma
                  máquina para verlo reflejado.)
                </p>
              </>
            )}
          </div>
        </details>
      ))
    }
  </div>

  <details class="info-padres">
    <summary class="info-padres__resumen">
      <span>Información de los padres</span>
      <span class="info-padres__flecha">▾</span>
    </summary>
    <div class="info-padres__cuerpo">
      <div class="info-padres__fila">
        <span class="info-padres__label">Acudiente</span>
        <span data-campo="acudiente-nombre">{aspirante.acudiente.nombre}</span>
      </div>
      <div class="info-padres__fila">
        <span class="info-padres__label">Teléfono</span>
        <span data-campo="acudiente-telefono">{aspirante.acudiente.telefono}</span>
      </div>
      <div class="info-padres__fila">
        <span class="info-padres__label">Radicado</span>
        <span>{aspirante.acudiente.radicado}</span>
      </div>
      {urlPortalPadre && (
        <a class="btn btn--outline info-padres__boton" href={urlPortalPadre} target="_blank" rel="noopener">
          Ver portal del padre
        </a>
      )}
    </div>
  </details>
</div>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
  }
  /* Astro añade una clase de scope a este selector, lo que le da más
     especificidad que la regla del navegador `[hidden] { display: none }` —
     sin esto, el panel se seguiría mostrando aunque tenga el atributo
     `hidden`. */
  .panel[hidden] {
    display: none;
  }
  .panel__header {
    margin-bottom: 20px;
  }
  .panel__header-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
  }
  .panel__header-acciones {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .btn--peligro {
    border-color: #e3b9a6;
  }
  .panel__edicion {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .panel__edicion[hidden] {
    display: none;
  }
  .campo-edicion {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 12px;
    font-weight: 700;
    color: #3b4457;
  }
  .campo-edicion input {
    border: 1px solid #dcd9cf;
    border-radius: 4px;
    padding: 9px 12px;
    font-size: 13.5px;
    color: var(--text);
    font-weight: 400;
    font-family: var(--font-sans);
  }
  .panel__edicion-botones {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }
  .eyebrow {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--terracota);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .panel__nombre {
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
  }
  .panel__grado {
    font-size: 12.5px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .panel__resultado {
    display: inline-block;
    margin-top: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 700;
    background: var(--pending-bg, #f7e3dd);
    color: var(--terracota);
  }
  .panel__resultado[hidden] {
    display: none;
  }

  .progreso {
    position: relative;
    padding-left: 26px;
    margin-bottom: 20px;
  }
  .progreso::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: var(--line);
  }
  .paso {
    position: relative;
    margin-bottom: 4px;
  }
  .paso + .paso {
    margin-top: 4px;
  }
  .paso__resumen {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
    padding: 8px 6px;
    border-radius: 6px;
    list-style: none;
  }
  .paso__resumen::-webkit-details-marker {
    display: none;
  }
  .paso__resumen:hover {
    background: var(--cream);
  }
  .paso__dot {
    position: absolute;
    left: -26px;
    top: 8px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid #5c6c8c;
    color: #5c6c8c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .paso__dot--completo {
    background: var(--terracota);
    border-color: var(--terracota);
    color: #fff;
  }
  .paso__texto {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .paso__label {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }
  .paso__estado {
    font-size: 11.5px;
    color: var(--text-faint);
  }
  .paso__acciones {
    padding: 4px 6px 14px 38px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .paso__nota {
    margin: 6px 0 0;
    font-size: 11.5px;
    color: var(--text-faint);
    line-height: 1.5;
    width: 100%;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text);
  }
  .check input {
    width: 16px;
    height: 16px;
    accent-color: var(--terracota);
  }
  .comite-acciones {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .btn--accion {
    padding: 6px 12px;
    font-size: 12px;
  }
  .btn--accion:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  /* Estado "activo": cuando ya se tomó esa decisión, el botón se rellena
     en vez de quedarse en outline, para que sea obvio cuál de las dos
     salidas quedó marcada (con el texto siempre legible). */
  .btn--accion-aprobar.btn--accion-activo {
    background: var(--success-text);
    border-color: var(--success-text);
    color: #fff;
  }
  .btn--accion-rechazar.btn--accion-activo {
    background: var(--terracota);
    border-color: var(--terracota);
    color: #fff;
  }
  .paso__nota--alerta,
  [data-campo='nota-bloqueo'] {
    color: var(--terracota);
  }

  .info-padres {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .info-padres__resumen {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--navy);
    list-style: none;
  }
  .info-padres__resumen::-webkit-details-marker {
    display: none;
  }
  .info-padres__flecha {
    color: var(--text-faint);
    transition: transform 0.15s ease;
  }
  .info-padres[open] .info-padres__flecha {
    transform: rotate(180deg);
  }
  .info-padres__cuerpo {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .info-padres__fila {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    color: var(--text);
  }
  .info-padres__label {
    color: var(--text-faint);
  }
  .info-padres__boton {
    margin-top: 8px;
    text-align: center;
    text-decoration: none;
  }
</style>

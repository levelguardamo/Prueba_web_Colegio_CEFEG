---
import type { DocumentoChecklist } from '../../data/types';

interface Props {
  documentos: DocumentoChecklist[];
}
const { documentos } = Astro.props;
const completados = documentos.filter((d) => !d.pendiente).length;
---

<div class="card">
  <div class="checklist__header">
    <h2 class="serif checklist__title">Checklist del proceso</h2>
    <span class="checklist__count">{completados} de {documentos.length} completado{completados === 1 ? '' : 's'}</span>
  </div>
  <div>
    {
      documentos.map((doc) => (
        <div class="checklist__row">
          <div class="checklist__doc">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8a93a3" stroke-width="1.8">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <path d="M14 2v6h6" />
            </svg>
            <span class="checklist__name">{doc.nombre}</span>
          </div>
          <div class="checklist__status">
            <span class={`chip ${doc.pendiente ? 'chip--pending' : 'chip--success'}`}>{doc.estado}</span>
            {doc.pendiente && (
              <button class="btn btn--outline" type="button">
                Subir archivo
              </button>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .checklist__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }
  .checklist__title {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
  }
  .checklist__count {
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .checklist__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    gap: 12px;
  }
  .checklist__doc {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .checklist__name {
    font-size: 14.5px;
    color: var(--text);
    font-weight: 500;
  }
  .checklist__status {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  @media (max-width: 520px) {
    .checklist__row {
      flex-wrap: wrap;
    }
    .checklist__status {
      width: 100%;
      justify-content: space-between;
      padding-left: 30px;
    }
  }
</style>
